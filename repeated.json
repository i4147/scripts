rchive/yy.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/update_omoji.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/dotr.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/rqd.py"]}, {"type": "FunctionDef", "name": "compress_file_zip", "source": "def compress_file_zip(src: Path, dst: Path) -> None:\n    with zipfile.ZipFile(dst, \"w\", compression=zipfile.ZIP_DEFLATED, compresslevel=9) as zf:\n        zf.write(src, arcname=src.name)", "count": 5, "files": ["/data/data/com.termux/files/home/isaac/may/scripts/archive/xxer_zstd.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/xxr.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/xxer.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/xxer_no_report.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/compresssor.py"]}, {"type": "FunctionDef", "name": "get_unique_filepath", "source": "def get_unique_filepath(base_path: Path) -> Path:\n    if not base_path.exists():\n        return base_path\n    name = base_path.stem\n    suffix = base_path.suffix\n    i = 1\n    while True:\n        new_path = base_path.with_name(f\"{name}_{i}{suffix}\")\n        if not new_path.exists():\n            return new_path\n        i += 1", "count": 5, "files": ["/data/data/com.termux/files/home/isaac/may/scripts/archive/ext.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/gext.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/gext5.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/gext2.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/ext4.py"]}, {"type": "FunctionDef", "name": "extract_entities_from_content", "source": "def extract_entities_from_content(content: str, path: Path) -> list[dict[str, Any]]:\n    try:\n        tree = ast.parse(content)\n        extractor = EntityExtractor(content, path)\n        extractor.visit(tree)\n        return extractor.entities\n    except SyntaxError:\n        return []\n    except Exception as e:\n        print(f\"Error parsing AST for {path}: {e}\")\n        return []", "count": 5, "files": ["/data/data/com.termux/files/home/isaac/may/scripts/archive/ext.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/gext.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/gext5.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/gext2.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/ext4.py"]}, {"type": "FunctionDef", "name": "is_python_file_no_extension", "source": "def is_python_file_no_extension(path: Path) -> bool:\n    if path.suffix:\n        return False\n    try:\n        with Path(path).open(encoding=\"utf-8\", errors=\"ignore\") as f:\n            first_lines = \"\".join(f.readlines(1024))\n            if re.match(\"#!\\\\s*/.*python\", first_lines):\n                return True\n            if \"def \" in first_lines or \"class \" in first_lines or \"import \" in first_lines:\n                return True\n    except:\n        pass\n    return False", "count": 5, "files": ["/data/data/com.termux/files/home/isaac/may/scripts/archive/ext.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/gext.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/gext5.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/gext2.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/ext4.py"]}, {"type": "FunctionDef", "name": "process_single_file", "source": "def process_single_file(path: Path) -> list[dict[str, Any]]:\n    try:\n        if path.suffix == \".py\" or is_python_file_no_extension(path):\n            content = path.read_text(encoding=\"utf-8\", errors=\"ignore\")\n            return extract_entities_from_content(content, path)\n        return []\n    except Exception as e:\n        print(f\"Error reading file {path}: {e}\")\n        return []", "count": 5, "files": ["/data/data/com.termux/files/home/isaac/may/scripts/archive/ext.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/gext.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/gext5.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/gext2.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/ext4.py"]}, {"type": "FunctionDef", "name": "worker_process", "source": "def worker_process(path_str: str) -> list[dict[str, Any]]:\n    path = Path(path_str)\n    if path.name.endswith(ARCHIVE_EXTENSIONS):\n        return process_archive(path)\n    return process_single_file(path)", "count": 5, "files": ["/data/data/com.termux/files/home/isaac/may/scripts/archive/ext.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/gext.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/gext5.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/gext2.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/ext4.py"]}, {"type": "FunctionDef", "name": "find_multiline_strings", "source": "def find_multiline_strings(\n    file_path: Path, min_lines: int = 2, min_chars: int = 10\n) -> Dict[str, List[Tuple[int, int]]]:\n    try:\n        with open(file_path, \"r\", encoding=\"utf-8\", errors=\"ignore\") as f:\n            lines = f.readlines()\n    except Exception as e:\n        print(f\"Error reading {file_path}: {e}\", file=sys.stderr)\n        return {}\n    strings = defaultdict(list)\n    i = 0\n    while i < len(lines):\n        if lines[i].strip():\n            start = i\n            string_lines = [lines[i]]\n            i += 1\n            while i < len(lines) and lines[i].strip():\n                string_lines.append(lines[i])\n                i += 1\n            end = i - 1\n            full_string = \"\".join(string_lines)\n            if len(string_lines) >= min_lines and len(full_string.strip()) >= min_chars:\n                normalized = normalize_string(full_string)\n                strings[normalized].append((start, end))\n        else:\n            i += 1\n    return strings", "count": 5, "files": ["/data/data/com.termux/files/home/isaac/may/scripts/archive/2026/mlic01_044806.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/2026/mlic30_213232.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/2026/mlic01_045007.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/2026/mlic01_045159.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/2026/mlic30_213835.py"]}, {"type": "FunctionDef", "name": "find_files", "source": "def find_files(directory: Path, extensions: Set[str] = None) -> List[Path]:\n    if extensions is None:\n        extensions = {\n            \".txt\",\n            \".md\",\n            \".py\",\n            \".js\",\n            \".html\",\n            \".css\",\n            \".xml\",\n            \".json\",\n            \".yaml\",\n            \".yml\",\n            \".csv\",\n            \".log\",\n            \".ini\",\n            \".cfg\",\n            \".conf\",\n            \".sh\",\n            \".bat\",\n            \".ps1\",\n            \".java\",\n            \".cpp\",\n            \".c\",\n            \".h\",\n            \".rb\",\n            \".php\",\n            \".sql\",\n        }\n    files = []\n    try:\n        for item in directory.rglob(\"*\"):\n            if item.is_file() and item.suffix.lower() in extensions:\n                files.append(item)\n    except PermissionError:\n        print(f\"Permission denied accessing {directory}\", file=sys.stderr)\n    return files", "count": 5, "files": ["/data/data/com.termux/files/home/isaac/may/scripts/archive/2026/mlic01_044806.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/2026/mlic30_213232.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/2026/mlic01_045007.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/2026/mlic01_045159.py", "/data/data/com.termux/files/home/isaac/may/scripts/archive/2026/mlic30_