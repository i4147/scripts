+    def refresh(self, cur_len: int) -> None:
+        terminal_width: int = get_terminal_size().columns
+        info: str = "%s '%s'...  %.2f%%" % (
+            self.prefix_info,
+            self.title,
+            cur_len / self.total * 100,
+        )
+        while len(info) > terminal_width - 20:
+            self.title = self.title[0:-4] + "..."
+            info = "%s '%s'...  %.2f%%" % (
+                self.prefix_info,
+                self.title,
+                cur_len / self.total * 100,
