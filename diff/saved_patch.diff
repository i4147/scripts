+def _iter_pygit2(opts: Options) -> Iterator[CommitRecord]:
+    import pygit2
+
+    repo = pygit2.Repository(opts.repo_path)
+
+    try:
+        ref = repo.revparse_single(opts.branch)
+    except (KeyError, ValueError):
