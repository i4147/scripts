+        ref = opts.branch
+        try:
+            head_sha = repo.refs[ref.encode()]
+        except KeyError:
+            try:
+                head_sha = repo.refs[f"refs/heads/{ref}".encode()]
+            except KeyError:
+                head_sha = ref.encode()
