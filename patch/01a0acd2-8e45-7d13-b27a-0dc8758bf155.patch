@@ -0,0 +1,79 @@
+#!/usr/bin/env python3
+"""Prove that a diff only moved whitespace - the safety net for the f-string joins.
+
+PROVENANCE: real - this is the check that backed the claim "the rendered strings are
+byte-identical".  For every changed file it concatenates the removed lines and the
+added lines, strips all whitespace from both and compares.  Identical results mean the
+edit deleted/normalised whitespace and nothing else, so no character of any string
+literal can have been lost.
+
+It does not prove that whitespace *inside* a string literal survived (stripping hides
+that), which is why the joined lines were also read by eye; the two together were the
+verification.
+
+Usage:
+    check_diff_whitespace_only.py [--rev A] [--rev B] [--verbose]
+"""
+from __future__ import annotations
+
+import argparse
+import re
+import subprocess
+import sys
+
+
+def diff(rev_a: str | None, rev_b: str | None) -> str:
+    cmd = ["git", "diff", "-U0"]
+    if rev_a:
+        cmd += [rev_a]
+        if rev_b:
+            cmd += [rev_b]
+    res = subprocess.run(cmd, capture_output=True, text=True)
+    if res.returncode != 0:
+        print(res.stderr, file=sys.stderr)
+        raise SystemExit(res.returncode)
+    return res.stdout
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(
+        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
+    )
+    ap.add_argument("--rev", nargs="*", default=None, help="git diff revisions (default: worktree vs index)")
+    ap.add_argument("--verbose", action="store_true")
+    args = ap.parse_args()
+    revs = args.rev or []
+    body = diff(revs[0] if revs else None, revs[1] if len(revs) > 1 else None)
+
+    blocks = re.split(r"^diff --git ", body, flags=re.M)[1:]
+    print(f"files changed: {len(blocks)}")
+    bad = []
+    for block in blocks:
+        path = block.splitlines()[0].split(" b/")[-1]
+        removed = [ln[1:] for ln in block.splitlines() if ln.startswith("-") and not ln.startswith("---")]
+        added = [ln[1:] for ln in block.splitlines() if ln.startswith("+") and not ln.startswith("+++")]
+        r = re.sub(r"\s+", "", "".join(removed))
+        a = re.sub(r"\s+", "", "".join(added))
+        same = r == a
+        print(
+            f"  {'SAME' if same else 'DIFF!!'} {path:58s} -{len(removed)}L +{len(added)}L"
+            f"  ws-stripped {len(r)}->{len(a)} chars"
+        )
+        if not same:
+            bad.append((path, r, a))
+
+    print(f"\nnon-whitespace-only changes: {len(bad)}")
+    for path, r, a in bad:
+        i = 0
+        while i < min(len(r), len(a)) and r[i] == a[i]:
+            i += 1
+        print(f"===== {path} (first divergence at char {i})")
+        print("  removed:", r[max(0, i - 60) : i + 60])
+        print("  added  :", a[max(0, i - 60) : i + 60])
+    if args.verbose and not bad:
+        print("(every hunk is whitespace-only)")
+    return 1 if bad else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
