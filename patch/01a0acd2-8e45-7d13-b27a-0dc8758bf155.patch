-                        code = f.read().decode("utf-8", errors="ignore")
-                        d = extract_from_ast(code, f"{path}:{m.name}")
-                        imports |= d["imports"]
-                        stars |= d["star_modules"]
-                        dyn |= d["dynamic"]
-                        rel |= d["relative"]
-                    except Exception:
-                        pass
-    except Exception:
-        pass
-    return {
-        "imports": sorted(imports),
-        "star_modules": sorted(stars),
-        "dynamic": sorted(dyn),
-        "relative": sorted(rel),
-    }
