-def process_py_file(path: Path) -> dict[str, list[str]]:
-    try:
-        text = path.read_text(encoding="utf-8", errors="ignore")
-    except Exception:
-        return {"imports": [], "star_modules": [], "dynamic": [], "relative": []}
-    return process_py_file_content(text, str(path))
