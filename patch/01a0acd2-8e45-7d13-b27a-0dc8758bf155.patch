index 0000000..21250b9
--- /dev/null
+++ b/arena/01_folderize/similarity_scan.py
@@ -0,0 +1,133 @@
+#!/usr/bin/env python3
+"""Near-duplicate scan: which scripts in this collection are the same program twice?
+
+PROVENANCE: real logic - this is the comparison used for both duplicate rounds,
+lifted out of the index generator and given a CLI.  Getting the numbers to match the
+published ones took one discovery: difflib's `autojunk` heuristic must be OFF.  With
+autojunk enabled (the default) a long single-line normalised file has its frequent
+characters treated as junk and the ratios collapse - pcssmin/pjsmin scored 89.2
+instead of 92.6 and clean_css/cleants 77.0 instead of 91.6.  With autojunk=False the
+scanner reproduces every published figure exactly.
+
+Normalisation: drop the shebang line, collapse every whitespace run to one space.
+Comparison: difflib.SequenceMatcher(..., autojunk=False).ratio() on that text.
+Scope: every pair inside one folder by default (the folders were built so that
+scripts doing the same job share one), or --all-pairs with a length prefilter.
+
+Usage:
+    similarity_scan.py [ROOT] [--threshold 0.90] [--all-pairs] [--json out.json]
+"""
+from __future__ import annotations
+
+import argparse
+import difflib
+import json
+import re
+import sys
+from pathlib import Path
+
+SKIP_DIRS = {".git", "__pycache__", "arena"}
+
+
+def normalise(path: Path) -> str:
+    text = path.read_text(encoding="utf-8", errors="replace")
+    text = re.sub(r"^#!.*\n", "", text)
+    return re.sub(r"\s+", " ", text).strip()
+
+
+def ratio(a: str, b: str) -> float:
+    return difflib.SequenceMatcher(None, a, b, autojunk=False).ratio()
+
+
+def collect(root: Path) -> dict[str, list[Path]]:
+    folders: dict[str, list[Path]] = {}
+    for entry in sorted(root.iterdir()):
+        if entry.name in SKIP_DIRS:
+            continue
+        if entry.is_dir():
+            pys = sorted(p for p in entry.iterdir() if p.suffix == ".py")
+            if pys:
+                folders[entry.name] = pys
+    return folders
+
+
+def scan_folders(root: Path, threshold: float) -> list[tuple]:
+    hits = []
+    for folder, paths in collect(root).items():
+        texts = {p.name: normalise(p) for p in paths}
+        names = sorted(texts)
+        for i in range(len(names)):
+            for j in range(i + 1, len(names)):
+                a, b = texts[names[i]], texts[names[j]]
+                if not a or not b:
+                    continue
+                if min(len(a), len(b)) / max(len(a), len(b)) < 0.75:
+                    continue
+                r = ratio(a, b)
+                if r >= threshold:
+                    hits.append((round(r * 100, 1), folder, names[i], names[j]))
+    hits.sort(key=lambda t: (-t[0], t[1], t[2]))
+    return hits
+
+
+def scan_all(root: Path, threshold: float) -> list[tuple]:
+    """Every pair in the repo, with a length prefilter.  Slow: O(n^2) difflib calls."""
+    files = [
+        p
+        for p in sorted(root.rglob("*.py"))
+        if not any(part in SKIP_DIRS for part in p.relative_to(root).parts)
+    ]
+    texts = {p: normalise(p) for p in files}
+    by_len = sorted(files, key=lambda p: len(texts[p]))
+    hits = []
+    for i, a in enumerate(by_len):
+        ta = texts[a]
+        for b in by_len[i + 1 :]:
+            tb = texts[b]
+            if len(ta) / max(1, len(tb)) < 0.75:
+                break  # sorted by length: nothing further can match
+            r = ratio(ta, tb)
+            if r >= threshold:
+                rel_a = a.relative_to(root)
+                rel_b = b.relative_to(root)
+                hits.append((round(r * 100, 1), str(rel_a.parent), rel_a.name, rel_b.name))
+    hits.sort(key=lambda t: (-t[0], t[1], t[2]))
+    return hits
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(
+        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
+    )
+    ap.add_argument("root", nargs="?", type=Path, default=Path("."))
+    ap.add_argument("--threshold", type=float, default=0.90)
+    ap.add_argument("--all-pairs", action="store_true")
+    ap.add_argument("--json", type=Path, default=None)
+    args = ap.parse_args()
+
+    hits = scan_all(args.root, args.threshold) if args.all_pairs else scan_folders(
+        args.root, args.threshold
+    )
+    scope = "all pairs" if args.all_pairs else "pairs inside each folder"
+    print(f"{len(hits)} pair(s) >= {args.threshold:.0%} ({scope})\n")
+    for pct, folder, a, b in hits:
+        print(f"  {pct:5.1f}%  {folder}/{a}  <->  {b}")
+
+    if args.json:
+        args.json.write_text(
+            json.dumps(
+                [
+                    {"percent": pct, "folder": folder, "a": a, "b": b}
+                    for pct, folder, a, b in hits
+                ],
+                indent=1,
+            )
+            + "\n",
+            encoding="utf-8",
+        )
+        print(f"\nwrote {args.json}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
