+#!/usr/bin/env bash
+# Report what git thinks the repo is, and whether the worktree agrees with it.
+#
+# PROVENANCE: real - these are the exact commands that revealed the sandbox had been
+# re-cloned between turns: HEAD had gone back to the pre-folderization base commit,
+# the index listed 2483 flat paths (including the deleted symlinks) while the
+# worktree held 1217 .py files in 161 folders, and the four local commits were not in
+# the object store any more.  The reflog showing only "clone:" + "checkout:" is what
+# proved it was a fresh clone rather than a reset.
+#
+# The recovery that followed (safe: no --hard, no clean, worktree untouched):
+#
+#     git reset --soft main     # branch pointer back onto the merged PR #1
+#     git add -A                # index = worktree
+#     git commit                # re-create the lost commits on top of main
+#
+# Usage: git_state_report.sh [REPO_DIR]
+set -uo pipefail
+cd "${1:-.}" || exit 1
+
+echo "== where am I"
+echo "HEAD: $(git rev-parse HEAD)"
+echo "branch: $(git rev-parse --abbrev-ref HEAD)"
+git log --oneline -4
+
+echo
+echo "== does the index agree with the worktree?"
+echo "index entries : $(git ls-files | wc -l)"
+echo "worktree .py  : $(find . -name '*.py' -not -path './.git/*' | wc -l)"
+echo "worktree dirs : $(find . -maxdepth 1 -type d -not -name '.' -not -name '.git' | wc -l)"
+echo "status lines  : $(git status --short | wc -l)"
+echo "--- first 5 index entries (flat names here = the index is the pre-folderization tree):"
+git ls-files | head -5
+
+echo
+echo "== is HEAD's tree folderized?"
+echo "--- top-level entries in HEAD:"
+git ls-tree --name-only HEAD | head -8
+echo "count: $(git ls-tree --name-only HEAD | wc -l)"
+
+echo
+echo "== refs and reflog (a reflog of only clone+checkout means the sandbox was re-cloned)"
+git branch -v | cat
+git for-each-ref --format='%(refname) %(objectname:short)' | head -20
+git reflog -12 | cat
+
+echo
+echo "== do the commits I expect still exist?"
+for c in "$@"; do :; done
+for c in ${EXPECT_COMMITS:-}; do
+    printf '  %s -> ' "$c"
+    git log -1 --format='%h %s' "$c" 2>&1 | head -1
+done
+[ -n "${EXPECT_COMMITS:-}" ] || echo "  (set EXPECT_COMMITS='abc123 def456' to probe specific commits)"
