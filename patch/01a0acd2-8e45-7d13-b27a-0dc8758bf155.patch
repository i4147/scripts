@@ -0,0 +1,77 @@
+#!/data/data/com.termux/files/home/.local/bin/python
+"""List files and directories in a folder, newest first, with their age.
+
+Usage: l.py [-r|--reverse] [-g|--newest] [N] [DIRECTORY]
+  -r / --reverse / --oldest   oldest first (this replaces lll.py, which was the same
+                              listing sorted the other way and mislabelled "newest")
+  -g / --newest               newest first (default)
+  N                           how many entries to show (default: 20)
+
+Symlinks, .git and __pycache__ entries are skipped; only the given directory is
+listed (no recursion).
+"""
+from __future__ import annotations
+
+import sys
+from datetime import datetime
+from pathlib import Path
+
+from dh import get_file_age
+
+EXCLUDED_DIRS = {".git", "__pycache__"}
+
+
+def format_time(ts) -> str:
+    return datetime.fromtimestamp(ts).strftime("%Y-%m-%d %H:%M:%S")
+
+
+def format_days(ts) -> str:
+    return f"{(datetime.now().timestamp() - ts) / 86400:.2f} days ago"
+
+
+def parse_args(argv: list[str]) -> tuple[bool, int, Path]:
+    reverse = False
+    num = 20
+    directory = Path.cwd()
+    i = 0
+    while i < len(argv):
+        arg = argv[i]
+        if arg in ("-r", "-R", "--reverse", "--oldest"):
+            reverse = True
+        elif arg in ("-g", "--newest", "--global"):
+            reverse = False
+        elif arg in ("-n", "--num"):
+            i += 1
+            num = int(argv[i])
+        elif arg in ("-h", "--help"):
+            print(__doc__)
+            raise SystemExit(0)
+        elif arg.lstrip("-").isdigit():
+            num = int(arg.lstrip("-"))
+        else:
+            directory = Path(arg)
+        i += 1
+    return reverse, num, directory
+
+
+def main() -> None:
+    reverse, num, cwd = parse_args(sys.argv[1:])
+    files = []
+    for p in cwd.glob("*"):
+        if p.is_symlink() or p.name in EXCLUDED_DIRS:
+            continue
+        if p.is_file() or p.is_dir():
+            files.append(p)
+    files.sort(key=lambda f: f.stat().st_ctime, reverse=not reverse)
+    order = "oldest" if reverse else "newest"
+    print(f"\nTop {num} {order} files in {cwd.resolve()}:\n")
+    for f in files[:num]:
+        mtime = get_file_age(f)
+        time_str = format_time(mtime)
+        days = format_days(mtime)
+        print(f"{time_str} ({days}) - {f.relative_to(cwd)}")
+    print()
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
