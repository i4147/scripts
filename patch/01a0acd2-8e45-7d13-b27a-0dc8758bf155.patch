+++ b/arena/01_folderize/dump_features.py
@@ -0,0 +1,207 @@
+#!/usr/bin/env python3
+"""Dump the "what does this script do" features of every .py file in a flat bin dir.
+
+PROVENANCE: reconstructed.  The original was run as a shell heredoc in the first step
+of this job (before the sandbox was re-cloned) and its output went to /tmp/feat.txt.
+This is the same extraction, made runnable and documented; ~783 of the 1238 scripts
+had no docstring at all, which is why the feature set below leans on imports, CLI
+flags, referenced extensions and external commands instead.
+
+The dump is what the folder taxonomy was designed from: scripts whose feature vectors
+looked alike do the same job, and that is how the 161 folders were chosen.
+
+Usage:
+    dump_features.py [ROOT] [-o features.jsonl] [--tsv features.tsv]
+"""
+from __future__ import annotations
+
+import argparse
+import ast
+import json
+import re
+import sys
+from pathlib import Path
+
+SKIP_DIRS = {".git", "__pycache__", "node_modules", ".venv", "arena"}
+
+# extensions a script mentions in string literals - a strong hint at its target files
+EXT_RE = re.compile(r"\.([A-Za-z0-9]{1,6})\b")
+# external binaries a script shells out to
+CMD_HINTS = (
+    "subprocess",
+    "os.system",
+    "os.popen",
+    "runcmd",
+    "Popen",
+    "check_call",
+    "check_output",
+    "run(",
+)
+STDLISH = set(sys.stdlib_module_names)
+
+
+def first_doc_line(tree: ast.AST) -> str:
+    doc = ast.get_docstring(tree)  # type: ignore[arg-type]
+    if not doc:
+        return ""
+    return " ".join(doc.strip().splitlines()[0].split())[:160]
+
+
+def features_of(path: Path) -> dict:
+    text = path.read_text(encoding="utf-8", errors="replace")
+    lines = text.splitlines()
+    out: dict = {
+        "path": str(path),
+        "name": path.name,
+        "lines": len(lines),
+        "shebang": lines[0] if lines and lines[0].startswith("#!") else "",
+        "docstring": "",
+        "imports_std": [],
+        "imports_3rd": [],
+        "imports_local": [],
+        "cli_flags": [],
+        "extensions": [],
+        "shells_out": False,
+        "commands": [],
+        "argv_positional": False,
+        "writes_files": False,
+        "multiprocessing": False,
+    }
+    try:
+        tree = ast.parse(text)
+    except SyntaxError as e:
+        out["parse_error"] = f"{type(e).__name__}: {e.msg} (line {e.lineno})"
+        return out
+
+    out["docstring"] = first_doc_line(tree)
+
+    siblings = {p.stem for p in path.parent.glob("*.py")}
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Import):
+            for a in node.names:
+                top = a.name.split(".")[0]
+                _bucket(out, top, siblings)
+        elif isinstance(node, ast.ImportFrom):
+            if node.level:
+                out["imports_local"].append("." * node.level + (node.module or ""))
+                continue
+            top = (node.module or "").split(".")[0]
+            _bucket(out, top, siblings)
+        elif isinstance(node, ast.Call):
+            fn = node.func
+            name = fn.attr if isinstance(fn, ast.Attribute) else getattr(fn, "id", "")
+            if name == "add_argument":
+                for a in node.args[:2]:
+                    if isinstance(a, ast.Constant) and isinstance(a.value, str):
+                        if a.value.startswith("-"):
+                            out["cli_flags"].append(a.value)
+            if name in ("write_text", "write_bytes", "open", "makedirs", "mkdir"):
+                out["writes_files"] = True
+
+    for hint in CMD_HINTS:
+        if hint in text:
+            out["shells_out"] = True
+            break
+    # literal command names in list form: ["zstd", "-19", ...]
+    for m in re.finditer(r"\[\s*[\"']([a-z][a-z0-9_.+-]{1,24})[\"']\s*,", text):
+        out["commands"].append(m.group(1))
+    out["commands"] = sorted(set(out["commands"]))[:12]
+
+    exts = {
+        "." + e.lower()
+        for e in EXT_RE.findall(text)
+        if e.lower()
+        in {
+            "py", "js", "css", "html", "htm", "json", "md", "txt", "csv", "tsv", "xml",
+            "yaml", "yml", "toml", "ini", "cfg", "sh", "bash", "zsh", "c", "h", "cpp",
+            "gz", "xz", "bz2", "zst", "zip", "tar", "tgz", "whl", "deb", "apk", "pdf",
+            "png", "jpg", "jpeg", "webp", "gif", "svg", "ico", "mp4", "mkv", "avi",
+            "mp3", "wav", "flac", "ogg", "ttf", "otf", "woff", "woff2", "eot", "srt",
+            "vtt", "po", "mo", "pyc", "pyi", "so", "dll", "bin", "raw", "pickle",
+            "pkl", "db", "sqlite", "sqlite3", "log", "bak", "tmp", "ipynb", "rst",
+        }
+    }
+    out["extensions"] = sorted(exts)
+    out["argv_positional"] = "sys.argv" in text
+    out["multiprocessing"] = bool(
+        re.search(r"multiprocessing|ProcessPoolExecutor|ThreadPoolExecutor|mpf3|mpf_async", text)
+    )
+    for key in ("imports_std", "imports_3rd", "imports_local", "cli_flags"):
+        out[key] = sorted(set(out[key]))
+    return out
+
+
+def _bucket(out: dict, top: str, siblings: set[str]) -> None:
+    if not top:
+        return
+    if top in siblings:
+        out["imports_local"].append(top)
+    elif top in STDLISH:
+        out["imports_std"].append(top)
+    else:
+        out["imports_3rd"].append(top)
+
+
+def walk(root: Path):
+    for p in sorted(root.rglob("*.py")):
+        if any(part in SKIP_DIRS for part in p.relative_to(root).parts):
+            continue
+        yield p
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(
+        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
+    )
+    ap.add_argument("root", nargs="?", type=Path, default=Path("."))
+    ap.add_argument("-o", "--jsonl", type=Path, default=None)
+    ap.add_argument("--tsv", type=Path, default=None)
+    ap.add_argument("--no-docstring-only", action="store_true",
+                    help="only dump scripts that have no docstring")
+    args = ap.parse_args()
+
+    rows = []
+    for p in walk(args.root):
+        f = features_of(p)
+        if args.no_docstring_only and f.get("docstring"):
+            continue
+        rows.append(f)
+
+    sink = args.jsonl.open("w", encoding="utf-8") if args.jsonl else sys.stdout
+    try:
+        for f in rows:
+            sink.write(json.dumps(f, ensure_ascii=False) + "\n")
+    finally:
+        if args.jsonl:
+            sink.close()
+
+    if args.tsv:
+        with args.tsv.open("w", encoding="utf-8") as fh:
+            fh.write("name\tlines\tdocstring\t3rd\textensions\tflags\tcommands\n")
+            for f in rows:
+                fh.write(
+                    "\t".join(
+                        [
+                            f["name"],
+                            str(f["lines"]),
+                            f["docstring"],
+                            ",".join(f["imports_3rd"]),
+                            ",".join(f["extensions"]),
+                            ",".join(f["cli_flags"]),
+                            ",".join(f["commands"]),
+                        ]
+                    )
+                    + "\n"
+                )
+
+    with_doc = sum(1 for f in rows if f["docstring"])
+    print(
+        f"{len(rows)} scripts dumped ({with_doc} with a docstring, "
+        f"{len(rows) - with_doc} without)",
+        file=sys.stderr,
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
