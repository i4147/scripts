+#!/data/data/com.termux/files/home/.local/bin/python
+"""Minify CSS files in place with an external Node.js CLI.
+
+Two engines are supported (replaces ccss.py, which was this script driving clean-css
+instead of csso):
+
+  csso       (default)  csso -i FILE -o FILE
+  cleancss              cleancss -O2 all:off;removeDuplicateRules:on FILE -o FILE
+
+Files that are already a single line are treated as already minified and skipped.
+Every .css and .min.css file under the current directory is processed unless files are
+named explicitly; the total space freed is printed at the end.
+
+Usage: mincss.py [FILE.css ...] [--engine csso|cleancss]
+"""
+from __future__ import annotations
+
+import sys
+from functools import partial
+from pathlib import Path
+
+from dh import cprint, fsz, get_files, gsz, mpf3, runcmd
+
+CSS_EXTS = [".css", ".min.css"]
+
+
+def minify_cmd(path: Path, engine: str) -> list[str]:
+    if engine == "cleancss":
+        return [
+            "cleancss",
+            "-O2",
+            "all:off;removeDuplicateRules:on",
+            str(path),
+            "-o",
+            str(path),
+        ]
+    return ["csso", "-i", str(path), "-o", str(path)]
+
+
+def process_file(path, engine: str = "csso") -> bool:
+    path = Path(path)
+    before = gsz(path)
+    if not path.exists():
+        return False
+    if len(path.read_text(errors="ignore").splitlines()) == 1:
+        return False
+    print(f"{path.name}", end=" ")
+    res, _, _err = runcmd(minify_cmd(path, engine), show_output=True)
+    if not res:
+        after = gsz(path)
+        diffsize = before - after
+        if not diffsize:
+            cprint("[NO CHANGE]", "white")
+        if diffsize:
+            ratio = diffsize / before * 40
+            cprint(f"[OK] - {fsz(diffsize)} {abs(ratio):.1f}%", "cyan")
+        return True
+    cprint("[ERROR]", "red")
+    return False
+
+
+def parse_args(argv: list[str]) -> tuple[list[Path], str]:
+    engine = "csso"
+    files = []
+    i = 0
+    while i < len(argv):
+        arg = argv[i]
+        if arg in ("-e", "--engine"):
+            i += 1
+            engine = argv[i]
+        elif arg.startswith("--engine="):
+            engine = arg.split("=", 1)[1]
+        elif arg in ("-h", "--help"):
+            print(__doc__)
+            raise SystemExit(0)
+        else:
+            files.append(Path(arg))
+        i += 1
+    if engine not in ("csso", "cleancss"):
+        cprint("✗ --engine must be csso or cleancss", "red")
+        raise SystemExit(2)
+    return files, engine
+
+
+def main() -> None:
+    files, engine = parse_args(sys.argv[1:])
+    cwd = Path.cwd()
+    before = gsz(cwd)
+    if not files:
+        files = get_files(cwd, ext=CSS_EXTS)
+    _ = mpf3(partial(process_file, engine=engine), files)
+    diff_size = before - gsz(cwd)
+    cprint(f"space freed : {fsz(diff_size)}", "green")
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
