+#!/data/data/com.termux/files/home/.local/bin/python
+"""Archive a directory and then delete what was archived, to free the space.
+
+Merges the two scripts that lived in this folder:
+
+  tar_folder.py  `tar_folder.py FOLDER` -> FOLDER.tar next to it, then delete the
+                 whole folder. (It called shutil.make_archive(base, output, format)
+                 with the arguments in the wrong order, so the format was the output
+                 path and the archive was never created - fixed here.)
+  tgzr.py        tar.gz of the current directory, then delete its *contents*
+                 concurrently with a pool of 8 workers, keeping the directory itself
+
+Deletion only happens after the archive exists and is non-empty.
+
+Usage: archive_and_clean.py [DIR] [options]
+
+  DIR                        directory to archive (default: the current one)
+  --format tar.gz|tar|zip    archive flavour (default: tar.gz)
+  --out FILE                 archive path (default: <parent>/<name>.<format>)
+  --remove-contents          delete the archived entries, keep DIR (default)
+  --remove-dir               delete DIR itself once it is archived
+  --keep                     archive only, delete nothing
+  --workers N                parallel deletion workers (default: 8, 1 = serial)
+  --exclude NAME             extra entry names to leave alone (repeatable)
+  --dry-run                  show what would happen, touch nothing
+"""
+from __future__ import annotations
+
+import argparse
+import multiprocessing
+import shutil
+import sys
+import tarfile
+import zipfile
+from collections.abc import Iterable
+from pathlib import Path
+
+FORMAT_SUFFIX = {"tar.gz": ".tar.gz", "tar": ".tar", "zip": ".zip"}
+DEFAULT_WORKERS = 8
+
+
+def build_parser() -> argparse.ArgumentParser:
+    ap = argparse.ArgumentParser(
+        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
+    )
+    ap.add_argument("directory", nargs="?", type=Path, default=Path("."))
+    ap.add_argument("--format", choices=tuple(FORMAT_SUFFIX), default="tar.gz")
+    ap.add_argument("--out", type=Path, default=None)
+    ap.add_argument("--remove-contents", action="store_true")
+    ap.add_argument("--remove-dir", action="store_true")
+    ap.add_argument("--keep", action="store_true")
+    ap.add_argument("--workers", type=int, default=DEFAULT_WORKERS)
+    ap.add_argument("--exclude", action="append", default=[])
+    ap.add_argument("--dry-run", action="store_true")
+    return ap
+
+
+def remove_item(path: Path) -> None:
+    """Delete one filesystem entry (directories recursively)."""
+    if path.is_dir() and not path.is_symlink():
+        shutil.rmtree(path)
+    elif path.exists() or path.is_symlink():
+        path.unlink()
+
+
+def remove_items_fast(items: Iterable[Path], workers: int) -> None:
+    item_list = list(items)
+    if not item_list:
+        return
+    if workers <= 1:
+        for item in item_list:
+            remove_item(item)
+        return
+    with multiprocessing.Pool(processes=workers) as pool:
+        results = [pool.apply_async(remove_item, (item,)) for item in item_list]
+        for result in results:
+            result.get()
+
+
+def make_archive(root: Path, archive_path: Path, fmt: str) -> None:
+    if fmt == "zip":
+        with zipfile.ZipFile(archive_path, "w", zipfile.ZIP_DEFLATED) as zf:
+            for item in sorted(root.rglob("*")):
+                zf.write(item, arcname=str(item.relative_to(root.parent)))
+        return
+    mode = "w:gz" if fmt == "tar.gz" else "w"
+    with tarfile.open(archive_path, mode) as tar:
+        tar.add(root, arcname=root.name)
+
+
+def main() -> int:
+    args = build_parser().parse_args()
+    root = args.directory.resolve()
+    if not root.exists():
+        print(f"✗ Error: directory '{root}' not found.", file=sys.stderr)
+        return 1
+    if not root.is_dir():
+        print(f"✗ Error: '{root}' is not a directory.", file=sys.stderr)
+        return 1
+
+    suffix = FORMAT_SUFFIX[args.format]
+    archive_path = args.out or (root.parent / f"{root.name}{suffix}")
+    archive_path = archive_path.resolve()
+    remove_dir = args.remove_dir
+    remove_anything = not args.keep
+    if remove_dir and args.exclude:
+        print(
+            "✗ --exclude cannot be combined with --remove-dir (the whole directory "
+            "goes); use the default --remove-contents instead.",
+            file=sys.stderr,
+        )
+        return 2
+
+    print(f"Creating archive: {archive_path}")
+    if args.dry_run:
+        entries = sorted(p for p in root.iterdir() if p.resolve() != archive_path)
+        print(f"[Dry run] would archive {root} ({len(entries)} top-level entries)")
+        if remove_anything:
+            what = "the directory itself" if remove_dir else "its contents"
+            print(f"[Dry run] would delete {what} with {args.workers} worker(s)")
+            if args.exclude:
+                print(f"[Dry run] would leave alone: {', '.join(args.exclude)}")
+        else:
+            print("[Dry run] would keep the original files (--keep)")
+        return 0
+
+    try:
+        make_archive(root, archive_path, args.format)
+    except Exception as e:
+        print(f"✗ Archiving failed: {e}", file=sys.stderr)
+        if archive_path.exists():
+            archive_path.unlink()
+        return 1
+
+    if not (archive_path.exists() and archive_path.stat().st_size > 0):
+        print("✗ Archive is missing or empty - nothing deleted.", file=sys.stderr)
+        return 1
+    print(f"✓ Archive written ({archive_path.stat().st_size:,} bytes)")
+
+    if not remove_anything:
+        print("Keeping the original files (--keep).")
+        return 0
+
+    excluded = {archive_path}
+    exclude_names: set[str] = set()
+    for name in args.exclude:
+        entry = Path(name)
+        if entry.is_absolute():
+            excluded.add(entry.resolve())
+        else:
+            # --exclude is relative to the directory being archived, not to the cwd
+            excluded.add((root / entry).resolve())
+            exclude_names.add(entry.name)
+    if remove_dir:
+        print("Removing the archived directory...")
+        try:
+            shutil.rmtree(root)
+            print(f"✓ Removed directory: {root}")
+        except Exception as e:
+            print(f"✗ Error removing '{root}': {e}", file=sys.stderr)
+            return 1
+        return 0
+
+    items = [
+        item
+        for item in root.iterdir()
+        if item.resolve() not in excluded and item.name not in exclude_names
+    ]
+    print(f"Removing {len(items)} archived entries with {args.workers} worker(s)...")
+    remove_items_fast(items, args.workers)
+    print("Cleanup complete.")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
