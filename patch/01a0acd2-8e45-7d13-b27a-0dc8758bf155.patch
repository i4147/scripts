+#!/data/data/com.termux/files/home/.local/bin/python
+"""Unpickle a file to JSON, to raw bytes, or just print it.
+
+Merges the three scripts that lived in this folder:
+
+  pkl2json.py    minimal: pickle -> sibling .json, indent 2, ensure_ascii=False,
+                 no reporting, no fallback for non-serializable objects
+  pkltojson.py   reports type/size/content, warns on a non-.pkl suffix, checks
+                 json-serializability and falls back to a lossy converter
+                 (set -> list, objects -> str, dict keys -> str)
+  upkl.py        pickle -> sibling .raw holding the unpickled bytes, then prints
+                 the object
+
+Usage: pickle_convert.py FILE [FILE...] [options]
+
+  --to json|raw|print   what to produce (default: json)
+  --out PATH            output file (default: the input's name with the new suffix)
+  --report              print type, size and the decoded content before writing
+  --quiet               print nothing but errors (for --to raw, which printed the
+                        object by default in upkl.py)
+  --no-fallback         fail instead of lossily converting non-serializable objects
+                        (pkl2json.py behaviour)
+  --indent N            JSON indentation (default: 2)
+  --ensure-ascii        escape non-ASCII in the JSON (pkltojson.py behaviour;
+                        pkl2json.py wrote UTF-8, which stays the default)
+  --no-suffix-warn      do not warn when the input is not named *.pkl
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import pickle
+import sys
+from pathlib import Path
+from typing import Any
+
+PICKLE_SUFFIXES = (".pkl", ".pickle")
+
+
+def build_parser() -> argparse.ArgumentParser:
+    ap = argparse.ArgumentParser(
+        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
+    )
+    ap.add_argument("files", nargs="+", type=Path)
+    ap.add_argument("--to", choices=("json", "raw", "print"), default="json")
+    ap.add_argument("--out", type=Path, default=None)
+    ap.add_argument("--report", action="store_true")
+    ap.add_argument("--quiet", action="store_true")
+    ap.add_argument("--no-fallback", action="store_true")
+    ap.add_argument("--indent", type=int, default=2)
+    ap.add_argument("--ensure-ascii", action="store_true")
+    ap.add_argument("--no-suffix-warn", action="store_true")
+    return ap
+
+
+def is_json_serializable(obj: Any) -> bool:
+    try:
+        json.dumps(obj)
+        return True
+    except (TypeError, ValueError):
+        return False
+
+
+def serialize_for_json(obj: Any) -> Any:
+    """Lossy converter for objects json cannot represent (pkltojson.py)."""
+    if isinstance(obj, (str, int, float, bool, type(None))):
+        return obj
+    if isinstance(obj, (list, tuple)):
+        return [serialize_for_json(item) for item in obj]
+    if isinstance(obj, dict):
+        return {str(k): serialize_for_json(v) for k, v in obj.items()}
+    if isinstance(obj, (set, frozenset)):
+        return [serialize_for_json(item) for item in sorted(obj, key=str)]
+    return str(obj)
+
+
+def load_pickle(path: Path) -> Any:
+    with path.open("rb") as fh:
+        return pickle.load(fh)
+
+
+def say(args, message: str) -> None:
+    if not args.quiet:
+        print(message)
+
+
+def output_path(args, src: Path, suffix: str) -> Path:
+    if args.out:
+        return args.out if len(args.files) == 1 else Path(f"{src.stem}{suffix}")
+    return src.with_suffix(suffix)
+
+
+def convert_one(path: Path, args) -> int:
+    if not path.exists():
+        print(f"✗ Error: file not found: {path}", file=sys.stderr)
+        return 1
+    if not args.no_suffix_warn and path.suffix.lower() not in PICKLE_SUFFIXES:
+        print(f"⚠️  Warning: expected a .pkl file, got {path.suffix or 'no suffix'}")
+    try:
+        data = load_pickle(path)
+    except Exception as e:
+        print(f"✗ Error loading pickle: {e}", file=sys.stderr)
+        return 1
+
+    say(args, f"✓ Loaded: {path}")
+    if args.report:
+        # an explicit --report always prints, even together with --quiet
+        print(f"  Type: {type(data).__name__}")
+        print(f"  Size: {len(str(data))} chars\n")
+        print("Content:")
+        print("-" * 40)
+        try:
+            print(json.dumps(data, indent=args.indent, default=str))
+        except Exception:
+            print(repr(data))
+        print("-" * 40)
+
+    if args.to == "print":
+        if args.quiet:
+            print(data)
+        return 0
+
+    if args.to == "raw":
+        if not isinstance(data, (bytes, bytearray)):
+            print(
+                f"✗ --to raw needs a pickle that unpickles to bytes, got "
+                f"{type(data).__name__}",
+                file=sys.stderr,
+            )
+            return 1
+        dest = output_path(args, path, ".raw")
+        dest.write_bytes(bytes(data))
+        say(args, f"✓ Saved {len(data)} bytes to: {dest}")
+        if not args.quiet:
+            print(data)
+        return 0
+
+    dest = output_path(args, path, ".json")
+    dumps_kwargs = {"indent": args.indent, "ensure_ascii": args.ensure_ascii}
+    if is_json_serializable(data):
+        try:
+            with dest.open("w", encoding="utf-8") as fh:
+                json.dump(data, fh, **dumps_kwargs)
+            say(args, f"\n✓ Saved to: {dest}")
+            return 0
+        except Exception as e:
+            print(f"\n✗ Failed to save JSON: {e}", file=sys.stderr)
+            return 1
+    if args.no_fallback:
+        print(f"\n✗ {path.name} is not JSON serializable (use without --no-fallback)")
+        return 1
+    try:
+        with dest.open("w", encoding="utf-8") as fh:
+            json.dump(serialize_for_json(data), fh, **dumps_kwargs)
+        say(args, f"\n⚠ Converted non-serializable objects → {dest}")
+        return 0
+    except Exception as e:
+        print(f"\n✗ Cannot convert to JSON: {e}", file=sys.stderr)
+        return 1
+
+
+def main() -> int:
+    args = build_parser().parse_args()
+    if args.out and len(args.files) > 1:
+        print("✗ --out only works with a single input file", file=sys.stderr)
+        return 2
+    rc = 0
+    for path in args.files:
+        rc |= convert_one(path, args)
+    return rc
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
