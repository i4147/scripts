+++ b/arena/01_folderize/folderize.py
@@ -0,0 +1,143 @@
+#!/usr/bin/env python3
+"""Turn a flat directory of .py scripts into one sub-directory per job.
+
+PROVENANCE: reconstructed.  The original was run as a shell heredoc using
+shutil.move() plus `git add -A` (git detected all 1234 moves as 100 % renames); its
+first version crashed with FileNotFoundError because the folder-set comprehension
+iterated over `cnt.values()` (ints) instead of `cnt.items()` - that bug is fixed here.
+
+What it does, in the order the original ran:
+
+  1. read a mapping  {script name or path: folder name}
+  2. create the folders
+  3. move every mapped .py file into its folder
+  4. delete the extension-less symlinks that mirrored each script name
+     (`20most -> /data/data/com.termux/files/home/bin/20most.py`): they pointed at
+     absolute Termux paths and were broken duplicates of the file names
+  5. enforce the "no single-member folder" rule - a folder that ended up with one
+     script has that script moved back to the root and the folder removed
+  6. print a report
+
+Nothing is deleted without --delete-symlinks, and --dry-run shows the whole plan.
+
+Usage:
+    folderize.py ROOT --map folder_map.json [--dry-run] [--delete-symlinks]
+                     [--allow-single-member]
+"""
+from __future__ import annotations
+
+import argparse
+import collections
+import json
+import shutil
+import sys
+from pathlib import Path
+
+SKIP_DIRS = {".git", "__pycache__", "arena"}
+
+
+def load_mapping(path: Path) -> dict[str, str]:
+    """Accept {name: folder}, {folder: [names]}, or derive_folder_map.py's output."""
+    data = json.loads(path.read_text(encoding="utf-8"))
+    if isinstance(data, dict) and isinstance(data.get("map"), dict):
+        data = data["map"]  # the artifact derive_folder_map.py writes
+    out: dict[str, str] = {}
+    for key, value in data.items():
+        if isinstance(value, str):
+            out[Path(key).name] = value
+        elif isinstance(value, (list, tuple)):
+            for name in value:
+                out[Path(name).name] = key
+        elif isinstance(value, dict) and "scripts" in value:
+            for name in value["scripts"]:
+                out[Path(name).name] = key
+    return out
+
+
+def plan(root: Path, mapping: dict[str, str], delete_symlinks: bool, allow_single: bool):
+    moves: list[tuple[Path, Path]] = []
+    missing: list[str] = []
+    symlinks: list[Path] = []
+
+    for entry in sorted(root.iterdir()):
+        if entry.name in SKIP_DIRS:
+            continue
+        if entry.is_symlink() and not entry.suffix:
+            symlinks.append(entry)
+        elif entry.is_file() and entry.suffix == ".py":
+            folder = mapping.get(entry.name)
+            if folder is None:
+                missing.append(entry.name)
+            else:
+                moves.append((entry, root / folder / entry.name))
+
+    if delete_symlinks:
+        # only the symlinks whose target name we actually have a script for
+        names = {src.name for src, _ in moves}
+        symlinks = [s for s in symlinks if f"{s.name}.py" in names or s.name in names]
+
+    demotions: list[tuple[Path, Path]] = []
+    if not allow_single:
+        per_folder = collections.Counter(dst.parent.name for _, dst in moves)
+        for src, dst in moves:
+            if per_folder[dst.parent.name] == 1:
+                demotions.append((dst, root / dst.name))
+
+    return moves, missing, symlinks, demotions
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(
+        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
+    )
+    ap.add_argument("root", type=Path)
+    ap.add_argument("--map", required=True, type=Path, help="JSON name -> folder mapping")
+    ap.add_argument("--dry-run", action="store_true")
+    ap.add_argument("--delete-symlinks", action="store_true")
+    ap.add_argument(
+        "--allow-single-member",
+        action="store_true",
+        help="keep folders that would hold only one script",
+    )
+    args = ap.parse_args()
+
+    root = args.root.resolve()
+    mapping = load_mapping(args.map)
+    moves, missing, symlinks, demotions = plan(
+        root, mapping, args.delete_symlinks, args.allow_single_member
+    )
+
+    print(f"mapping entries        : {len(mapping)}")
+    print(f"scripts to move        : {len(moves)}")
+    print(f"folders to create      : {len({dst.parent for _, dst in moves}) - len(demotions)}")
+    print(f"symlinks to delete     : {len(symlinks)}")
+    print(f"single-member demotions: {len(demotions)}")
+    print(f"unmapped scripts       : {len(missing)}")
+    if missing[:10]:
+        print("  e.g. " + ", ".join(missing[:10]))
+
+    if args.dry_run:
+        print("\n[dry run] nothing changed")
+        return 0
+
+    for src, dst in moves:
+        dst.parent.mkdir(parents=True, exist_ok=True)
+        shutil.move(str(src), str(dst))
+    for dst, back in demotions:
+        if dst.exists():
+            shutil.move(str(dst), str(back))
+    for folder in {dst.parent for _, dst in moves}:
+        if folder.is_dir() and not any(folder.iterdir()):
+            folder.rmdir()
+    for link in symlinks:
+        if link.is_symlink():
+            link.unlink()
+
+    left = [p for p in root.iterdir() if p.is_file() and p.suffix == ".py"]
+    folders = [p for p in root.iterdir() if p.is_dir() and p.name not in SKIP_DIRS]
+    print(f"\ndone: {len(folders)} folders, {sum(1 for f in folders for _ in f.glob('*.py'))} scripts grouped, {len(left)} in the root")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
