+#!/usr/bin/env python3
+"""Recover the flat-name -> folder mapping that step 1 applied, straight out of git.
+
+PROVENANCE: real - this is the command used to check what survived the sandbox
+re-clone, turned into a script.  The pre-folderization tree is still reachable as the
+base commit, so git's rename detection gives the exact assignment that was made:
+
+    git diff --find-renames --name-status BASE HEAD
+
+R100 entries are the moves (old flat path -> new folder path), D entries are the
+broken symlinks and the scripts later deleted as duplicates.
+
+Usage:
+    derive_folder_map.py [BASE] [HEAD] [-o folder_map.json] [--report]
+
+Defaults: BASE = the repo's first commit reachable as 8e7c1c8 (the flat bin dir),
+HEAD = the current branch tip.
+"""
+from __future__ import annotations
+
+import argparse
+import collections
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+DEFAULT_BASE = "8e7c1c8"
+
+
+def toplevel() -> Path:
+    res = subprocess.run(
+        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True
+    )
+    return Path(res.stdout.strip())
+
+
+def name_status(base: str, head: str) -> list[str]:
+    res = subprocess.run(
+        ["git", "diff", "--find-renames", "--name-status", base, head],
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    return res.stdout.splitlines()
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(
+        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
+    )
+    ap.add_argument("base", nargs="?", default=DEFAULT_BASE)
+    ap.add_argument("head", nargs="?", default="HEAD")
+    ap.add_argument("-o", "--output", type=Path, default=Path("folder_map.json"))
+    ap.add_argument("--report", action="store_true")
+    args = ap.parse_args()
+
+    mapping: dict[str, str] = {}
+    deleted: list[str] = []
+    added: list[str] = []
+    for line in name_status(args.base, args.head):
+        parts = line.split("\t")
+        kind = parts[0]
+        if kind.startswith("R"):
+            old, new = parts[1], parts[2]
+            mapping[Path(old).name] = str(Path(new).parent)
+        elif kind == "D":
+            deleted.append(parts[1])
+        elif kind == "A":
+            added.append(parts[1])
+
+    payload = {
+        "base": args.base,
+        "head": args.head,
+        "note": (
+            "map = the step-1 assignment as git's rename detection records it "
+            "(flat file name -> folder). Scripts that were later deleted as "
+            "duplicates show up under deleted_paths; merged scripts written later "
+            "are new files, not renames, so they appear under added_paths and in "
+            "worktree but not in map."
+        ),
+        "scripts": len(mapping),
+        "map": dict(sorted(mapping.items())),
+        "deleted_paths": sorted(deleted),
+        "added_paths": sorted(added),
+        "worktree": {
+            folder.name: sorted(p.name for p in folder.glob("*.py"))
+            for folder in sorted(toplevel().iterdir())
+            if folder.is_dir() and not folder.name.startswith(".") and folder.name != "arena"
+        },
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(
+        json.dumps(payload, ensure_ascii=False, indent=1) + "\n", encoding="utf-8"
+    )
+    print(f"wrote {args.output}: {len(mapping)} script moves, {len(deleted)} deletions")
+
+    if args.report:
+        sizes = collections.Counter(mapping.values())
+        print(f"folders: {len(sizes)}")
+        print("biggest:", ", ".join(f"{f}({n})" for f, n in sizes.most_common(5)))
+        print("smallest:", ", ".join(f"{f}({n})" for f, n in sizes.most_common()[-5:]))
+        singles = [f for f, n in sizes.items() if n == 1]
+        print(f"single-member folders: {len(singles)} {singles[:5]}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
