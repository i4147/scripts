-def load_set_file(path: str) -> set[str]:
-    out = set()
-    try:
-        with Path(path).open(encoding="utf-8", errors="ignore") as f:
-            for line in f:
-                v = line.strip()
-                if v:
-                    out.add(v)
-    except Exception:
-        pass
-    return out
-
-
-def load_mapping(path: str) -> dict[str, str]:
-    out: dict[str, str] = {}
-    try:
-        with Path(path).open(encoding="utf-8", errors="ignore") as f:
-            for line in f:
-                line = line.strip()
-                if not line or line.startswith("#"):
-                    continue
-                if "=" in line:
-                    k, v = line.split("=", 1)
-                    out[k.strip()] = v.strip()
-    except Exception:
-        pass
-    return out
