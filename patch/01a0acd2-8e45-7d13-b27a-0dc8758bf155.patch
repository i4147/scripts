+#!/data/data/com.termux/files/home/.local/bin/python
+"""List the newest or the oldest entries under a directory, with their timestamps.
+
+Replaces newest_files.py and oldest_files.py, which were the same walk sorted in
+opposite directions - and both printed a header contradicting their own sort order
+("Top N oldest files" over a newest-first sort, "Top N fresh files" over an
+oldest-first sort).
+
+Usage: files_by_time.py [DIRECTORY] [-n N] [--newest|--oldest|--order newest|oldest]
+                        [--time mtime|ctime|atime] [-r|--recursive]
+  -n, --num N      how many entries to show (default: 10)
+  --newest         most recent first (default)
+  --oldest         least recent first
+  --time ATTR      which timestamp to sort and display by (default: mtime)
+  -r, --recursive  walk the whole tree (files only); default lists one level
+
+Symlinks and anything under .git / __pycache__ are skipped.
+"""
+from __future__ import annotations
+
+import sys
+from datetime import datetime
+from pathlib import Path
+
+from dh import get_file_age
+
+EXCLUDED_DIRS = {".git", "__pycache__"}
+TIME_ATTRS = ("mtime", "ctime", "atime")
+
+
+def format_time(ts) -> str:
+    return datetime.fromtimestamp(ts).strftime("%Y-%m-%d %H:%M:%S")
+
+
+def parse_args(argv: list[str]) -> tuple[Path, int, bool, bool, str]:
+    directory = Path.cwd()
+    num = 10
+    oldest = False
+    recursive = False
+    time_attr = "mtime"
+    i = 0
+    while i < len(argv):
+        arg = argv[i]
+        if arg in ("-r", "-R", "--recursive"):
+            recursive = True
+        elif arg in ("-g", "--global", "--newest"):
+            oldest = False
+        elif arg in ("--oldest",):
+            oldest = True
+        elif arg == "--order":
+            i += 1
+            oldest = argv[i] == "oldest"
+        elif arg.startswith("--order="):
+            oldest = arg.split("=", 1)[1] == "oldest"
+        elif arg == "--time":
+            i += 1
+            time_attr = argv[i]
+        elif arg.startswith("--time="):
+            time_attr = arg.split("=", 1)[1]
+        elif arg in ("-n", "--num"):
+            i += 1
+            num = int(argv[i])
+        elif arg in ("-h", "--help"):
+            print(__doc__)
+            raise SystemExit(0)
+        elif arg.lstrip("-").isdigit():
+            num = int(arg.lstrip("-"))
+        else:
+            directory = Path(arg)
+        i += 1
+    if time_attr not in TIME_ATTRS:
+        print(f"✗ unknown --time '{time_attr}' (use: {', '.join(TIME_ATTRS)})")
+        raise SystemExit(2)
+    return directory, num, oldest, recursive, time_attr
+
+
+def collect(directory: Path, recursive: bool) -> list[Path]:
+    entries = []
+    walker = directory.rglob("*") if recursive else directory.glob("*")
+    for p in walker:
+        if p.is_symlink():
+            continue
+        try:
+            rel_parts = p.relative_to(directory).parts
+        except ValueError:
+            continue
+        if any(part in EXCLUDED_DIRS for part in rel_parts):
+            continue
+        if p.is_file() or (p.is_dir() and not recursive):
+            entries.append(p)
+    return entries
+
+
+def main() -> None:
+    directory, num, oldest, recursive, time_attr = parse_args(sys.argv[1:])
+    if not directory.exists():
+        print(f"✗ '{directory}' does not exist")
+        raise SystemExit(1)
+    attr = f"st_{time_attr}"
+    files = collect(directory, recursive)
+    files.sort(key=lambda f: getattr(f.stat(), attr), reverse=not oldest)
+    order = "oldest" if oldest else "newest"
+    scope = "recursive" if recursive else "top-level"
+    print(f"\nTop {num} {order} {scope} entries by {time_attr} in {directory.resolve()}:\n")
+    for f in files[:num]:
+        ts = get_file_age(f)
+        print(f"{format_time(ts)}  -  {f.relative_to(directory)}")
+    print()
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
