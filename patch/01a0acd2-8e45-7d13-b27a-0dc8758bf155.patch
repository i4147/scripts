new file mode 100644
index 0000000..bc8bdc0
--- /dev/null
+++ b/qrcode_tools/qr_decode.py
@@ -0,0 +1,111 @@
+#!/data/data/com.termux/files/home/.local/bin/python
+"""Decode QR codes (and, optionally, any other barcode) out of image files.
+
+Merges the two scripts that lived in this folder:
+
+  qrcode_reader.py  decodes every symbology pyzbar finds, prints type and bounding
+                    box, repeats the first payload at the end, exits 1 on any error
+  qrcoder.py        decodes QRCODE only, converts the image to RGB first, prints one
+                    payload per line, never fails
+
+Usage: qr_decode.py IMAGE [IMAGE...] [options]
+
+  --all-types     report every symbology, not just QRCODE
+  --details       also print type and position (left/top/width/height)
+  --first         also print the first payload alone at the end (script friendly)
+  --raw           print payloads only, one per line, no decoration
+  --no-convert    do not convert non-RGB images before decoding
+  --strict        exit 1 when an image cannot be read or holds no code
+"""
+from __future__ import annotations
+
+import argparse
+import sys
+from pathlib import Path
+
+from PIL import Image
+from pyzbar import pyzbar
+
+
+def build_parser() -> argparse.ArgumentParser:
+    ap = argparse.ArgumentParser(
+        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
+    )
+    ap.add_argument("images", nargs="+", type=Path)
+    ap.add_argument("--all-types", action="store_true")
+    ap.add_argument("--details", action="store_true")
+    ap.add_argument("--first", action="store_true")
+    ap.add_argument("--raw", action="store_true")
+    ap.add_argument("--no-convert", action="store_true")
+    ap.add_argument("--strict", action="store_true")
+    return ap
+
+
+def decode_image(path: Path, all_types: bool, convert: bool) -> list:
+    with Image.open(path) as img:
+        if convert and img.mode != "RGB":
+            img = img.convert("RGB")
+        decoded = pyzbar.decode(img)
+    if all_types:
+        return list(decoded)
+    return [obj for obj in decoded if obj.type == "QRCODE"]
+
+
+def report(path: Path, objects: list, args) -> list[str]:
+    payloads = []
+    for obj in objects:
+        try:
+            data = obj.data.decode("utf-8")
+        except UnicodeDecodeError:
+            data = repr(obj.data)
+        payloads.append(data)
+        if args.raw:
+            print(data)
+            continue
+        if args.details:
+            rect = obj.rect
+            print(f"  Type: {obj.type}")
+            pos = f"left={rect.left}, top={rect.top}, width={rect.width}, height={rect.height}"
+            print(f"  Position: ({pos})")
+        print(f"  Data: {data}")
+    return payloads
+
+
+def main() -> int:
+    args = build_parser().parse_args()
+    every_payload: list[str] = []
+    failures = 0
+    for path in args.images:
+        if not path.exists():
+            print(f"✗ Error: image file '{path}' not found.", file=sys.stderr)
+            failures += 1
+            continue
+        if not args.raw:
+            print(f"Reading codes from: {path}\n")
+        try:
+            objects = decode_image(path, args.all_types, not args.no_convert)
+        except Exception as e:
+            print(f"✗ Error processing image: {e}", file=sys.stderr)
+            failures += 1
+            continue
+        if not objects:
+            if not args.raw:
+                print("  No QR code found in the image.")
+            if args.strict:
+                failures += 1
+            continue
+        if not args.raw:
+            print(f"Found {len(objects)} code(s):")
+            print("-" * 40)
+        every_payload.extend(report(path, objects, args))
+        if not args.raw:
+            print("-" * 40)
+    if args.first and every_payload:
+        if not args.raw:
+            print("\nFirst code data only:")
+        print(every_payload[0])
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
