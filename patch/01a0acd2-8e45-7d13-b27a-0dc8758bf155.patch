+++ b/arena/02_merge/regen_index.py
@@ -0,0 +1,220 @@
+#!/usr/bin/env python3
+"""Regenerate SCRIPT_INDEX.md: folder listing, duplicate-collapse log, pair report.
+
+PROVENANCE: real - this is the generator that produced SCRIPT_INDEX.md after the
+>=90 % dedup round and the Python 3.11 pass (with the two patches it needed:
+autojunk=False in the scan, and a blank line after the last bullet of the pair list).
+Since then it only gained the `arena/` skip and this docstring.
+
+Two things to know before re-running it:
+
+  1. It carries the round-1 collapse log forward by *reading the existing
+     SCRIPT_INDEX.md* and copying everything from "## Duplicate collapse log" up to
+     "### Remaining >= 90 % pairs".  The round-2 prose (the merge table, the deletion
+     table, the bug list, the kept-apart table, the 3.11 section) is embedded below -
+     so as the one-script-per-folder merge progresses, that prose is what needs
+     editing, not the machinery.
+  2. The scan is intra-folder and uses difflib with autojunk=False; see
+     ../01_folderize/similarity_scan.py for why autojunk has to be off.
+
+Usage:
+    regen_index.py [ROOT]      # writes ROOT/SCRIPT_INDEX.md
+"""
+from __future__ import annotations
+
+import difflib
+import os
+import re
+import sys
+from pathlib import Path
+
+SKIP = {".git", "__pycache__", "arena"}
+
+
+def norm(p: Path) -> str:
+    t = p.read_text(encoding="utf-8", errors="replace")
+    t = re.sub(r"^#!.*\n", "", t)
+    return re.sub(r"\s+", " ", t).strip()
+
+
+def main() -> int:
+    root = Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else Path.cwd().resolve()
+    os.chdir(root)
+
+    folders: dict[str, list[str]] = {}
+    root_files: list[str] = []
+    for entry in sorted(os.listdir(".")):
+        if entry in SKIP:
+            continue
+        p = Path(entry)
+        if p.is_dir():
+            pys = sorted(x.name for x in p.iterdir() if x.suffix == ".py")
+            if pys:
+                folders[entry] = pys
+        elif p.suffix == ".py":
+            root_files.append(entry)
+
+    texts = {(f, n): norm(Path(f) / n) for f, ns in folders.items() for n in ns}
+    pairs = []
+    for f, ns in folders.items():
+        for i in range(len(ns)):
+            for j in range(i + 1, len(ns)):
+                a, b = texts[(f, ns[i])], texts[(f, ns[j])]
+                if not a or not b:
+                    continue
+                if min(len(a), len(b)) / max(len(a), len(b)) < 0.75:
+                    continue
+                r = difflib.SequenceMatcher(None, a, b, autojunk=False).ratio()
+                if r >= 0.90:
+                    pairs.append((round(r * 100, 1), f, ns[i], ns[j]))
+    pairs.sort(key=lambda t: (-t[0], t[1], t[2]))
+
+    n_scripts = sum(len(v) for v in folders.values())
+    old = Path("SCRIPT_INDEX.md").read_text(encoding="utf-8")
+    round1 = old[old.index("## Duplicate collapse log") : old.index("### Remaining ≥ 90 % pairs")]
+    round1 = round1.replace(
+        "found 21 pairs ≥ 95 % similar", "found 21 pairs ≥ 95 % similar (round 1)"
+    )
+
+    out: list[str] = []
+    w = out.append
+    w("# Script index — grouped by functionality\n")
+    w(
+        f"{len(folders)} folders · {n_scripts} scripts grouped · {len(root_files)} scripts in the repo root."
+        "\n"
+    )
+    w(
+        "Every folder holds scripts that do the same job. Folders are listed biggest-first, so the\n"
+        "clusters with the most overlap come first. A folder is only created when it has at least\n"
+        "two members; scripts with a unique job stay in the root.\n"
+    )
+    for f, ns in sorted(folders.items(), key=lambda kv: (-len(kv[1]), kv[0])):
+        w(f"## `{f}/` — {len(ns)} scripts\n")
+        w(", ".join(f"`{n}`" for n in ns) + "\n")
+    w("## root (unique scripts — no folder created)\n")
+    w(", ".join(f"`{n}`" for n in root_files) + "\n")
+    w(round1.rstrip() + "\n")
+
+    w("## Round 2 — the ≥ 90 % pairs\n")
+    w(
+        "The 18 pairs that round 1 kept were re-examined one diff at a time. 15 of them turned out\n"
+        "to be the same program twice (opposite direction, another library, another name for the\n"
+        "same job), so they were collapsed: **15 scripts deleted, 2 new merged scripts, 6 existing\n"
+        "scripts given a flag**. 3 pairs are genuinely different jobs and stay.\n"
+    )
+    w("### Merged into one parameterised script\n")
+    w("| new / updated script | absorbs | how to select the old behaviour |")
+    w("| --- | --- | --- |")
+    w(
+        "| `find_files_by_time/files_by_time.py` *(new)* | `newest_files.py`, `oldest_files.py` | "
+        "`--order newest\\|oldest` (default newest), `--time mtime\\|ctime\\|atime`, `-r/--recursive`, `-n N` |"
+    )
+    w(
+        "| `archive_convert_codec/convert_gz_xz.py` *(new)* | `gz2xz.py`, `xz2gz.py` | "
+        "direction is picked per file from its extension, so one pass converts a mixed directory; `--to auto\\|xz\\|gz`, `--dry-run` |"
+    )
+    w("| `ls_dir_listing/l.py` | `lll.py` | `-r/--reverse` lists oldest first |")
+    w(
+        "| `html_md_convert/html_to_md.py` | `tomd.py` | `--engine html2text\\|markdownify` (default `html2text`), `--keep` to leave the `.html` in place |"
+    )
+    w("| `minify_web_assets/mincss.py` | `ccss.py` | `--engine csso\\|cleancss` (default `csso`) |")
+    w(
+        "| `translate_dict_json/mendic.py` | `mfadic.py` | `--direction en2fa\\|fa2en` (default `en2fa`), `--keep` to leave the source JSON files in place |"
+    )
+    w(
+        "| `scrape_site_links/findlinks.py` | `findpdflinks.py` | `findlinks.py URL [EXT] [MAX_PAGES] [DELAY]` — `.pdf` is the default `EXT` |\n"
+    )
+    w("### Deleted as superseded by a sibling\n")
+    w("| deleted | kept | why |")
+    w("| --- | --- | --- |")
+    w(
+        "| `archive_extract/extar.py` | `ex_tar.py` | the kept one extracts with `filter=\"data\"` (blocks path traversal) and has `--keep-original` |"
+    )
+    w("| `gen_requirements_from_imports/imz.py` | `imz2.py` | `imz2` is the documented rewrite of `imz` and a strict superset |")
+    w("| `remove_unused_code/afkco.py` | `afk.py` | `afk` is `TYPE_CHECKING`-aware and also scans archives |")
+    w(
+        "| `html_single_file/mk_stand.py`, `mkst.py` | `inline_assets.py` | same \"inline the CSS/JS into one HTML file\" job; `inline_assets.py` is the documented one. The much larger `mkstand.py` is a separate implementation and stays |"
+    )
+    w("| `extract_python_entities/gext.py` | `gext2.py`, renamed to `gext.py` | kept the scope-aware implementation that also reports methods |\n")
+    w("### Bugs fixed on the way\n")
+    w("- `gz2xz.py` called `get_files()` without importing it — a `NameError` on every run.\n")
+    w(
+        "- `gz2xz.py` and `xz2gz.py` both `stat()`ed the source *after* `unlink()`ing it, so \"original size\",\n"
+        "  the ratio and the whole \"total space saved\" summary were always 0. `convert_gz_xz.py` measures first.\n"
+    )
+    w(
+        "- `newest_files.py` printed *\"Top N oldest files\"* over a newest-first sort, and `oldest_files.py`\n"
+        "  printed *\"Top N fresh files\"* over an oldest-first sort — the labels were swapped between the two\n"
+        "  files. `files_by_time.py` derives its header from `--order`.\n"
+    )
+    w(
+        "- `findlinks.py` ran `parsed = urlparse(url)` — `url` is undefined — whenever the start URL had no\n"
+        "  scheme, so `findlinks.py example.com .pdf` died with a `NameError`. Now `urlparse(start_url)`.\n"
+        "  Its `main()` also printed `__doc__` for usage, but the file had no docstring (`None`); it has one now.\n"
+    )
+    w("- `l.py` parsed `-r` into a variable that was never used, so the flag did nothing. It reverses now.\n")
+    w(
+        "- `ccss.py` read files with `read_text()` (no error handling); the merged `mincss.py` uses\n"
+        "  `errors=\"ignore\"` for its already-minified check.\n"
+    )
+    w("### Kept apart on purpose — same shape, different job\n")
+    w("| pair | similarity | why both stay |")
+    w("| --- | --- | --- |")
+    w("| `minify_web_assets/pcssmin.py` ↔ `pjsmin.py` | 92.6 % | CSS vs JavaScript |")
+    w("| `strip_comments_web/clean_css.py` ↔ `cleants.py` | 91.6 % | tree-sitter CSS vs TypeScript grammar |")
+    w(
+        "| `translate_code_comments/pytrans.py` ↔ `pytranslator.py` | 90.3 % | different detection engines (pycld2 vs langdetect) |\n"
+    )
+
+    by_folder: dict[str, list] = {}
+    for pct, f, a, b in pairs:
+        by_folder.setdefault(f, []).append((pct, a, b))
+    w(f"### Remaining ≥ 90 % pairs after round 2: {len(pairs)}\n")
+    if pairs:
+        w("All of them are in the \"kept apart on purpose\" table above.\n")
+        for f in sorted(by_folder):
+            w(f"#### `{f}/`\n")
+            items = by_folder[f]
+            for idx, (pct, a, b) in enumerate(items):
+                w(f"- **{pct}%** `{a}` ↔ `{b}`" + ("\n" if idx == len(items) - 1 else ""))
+    else:
+        w("None.\n")
+
+    w("## Python 3.11 parse pass\n")
+    w(
+        "`python3 -m compileall` under Python 3.11 failed on 31 of the scripts, all for the same\n"
+        "reason and none of them a real bug: `[tool.ruff] target-version = \"py312\"` lets the formatter\n"
+        "split a long f-string **expression** across physical lines, which only parses on Python 3.12+\n"
+        "(PEP 701). Example of what it produced:\n"
+    )
+    w("```python")
+    w('f"[DRY RUN] Would compress & {')
+    w("    'remove' if remove_original else 'keep'")
+    w('}: {input_path} -> {output_path}"')
+    w("```\n")
+    w(
+        "- **30 files fixed mechanically** — each split expression was joined back onto one line. Only\n"
+        "  whitespace *inside* `{...}` changed, so the rendered strings are byte-identical; every diff was\n"
+        "  verified to be whitespace-only and every file recompiled afterwards.\n"
+        "- **1 file fixed by hand** — `html_template_gen/make_template_html.py` built its table of contents\n"
+        "  with a generator expression spread over six lines *inside* a triple-quoted f-string, so that\n"
+        "  moved out into a `toc` variable computed before the template.\n"
+        "- **1 file needed nothing** — `remove_unused_code/afkco.py` was deleted in the dedup round above.\n"
+        f"- **Result: all {n_scripts + len(root_files)} scripts now parse under Python 3.11** (`compileall` is clean) and still parse\n"
+        "  under 3.12/3.13.\n"
+        "- Heads-up: running `ruff format` again with `target-version = \"py312\"` will re-split those\n"
+        "  f-strings. Set `target-version = \"py311\"` in `pyproject.toml` if the 3.11 compatibility should\n"
+        "  survive formatting.\n"
+    )
+    Path("SCRIPT_INDEX.md").write_text("\n".join(out), encoding="utf-8")
+    print(
+        f"SCRIPT_INDEX.md: {len(folders)} folders, {n_scripts} grouped + {len(root_files)} root, "
+        f"{len(pairs)} pairs ≥90%"
+    )
+    for p in pairs:
+        print("   pair:", p)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
