new file mode 100644
index 0000000..a491241
--- /dev/null
+++ b/arena/02_merge/fix_pep701_fstrings.py
@@ -0,0 +1,334 @@
+#!/usr/bin/env python3
+"""Rewrite PEP 701-only multi-line f-strings so the files also parse on Python 3.11.
+
+PROVENANCE: real - this is the transformer that fixed 30 of the 31 files that failed
+`python3 -m compileall` under Python 3.11 (the 31st needed a hand fix, and one of the
+31 had already been deleted as a duplicate).  It was run once over the repo from the
+repo root; the only change since then is the removal of a dead branch and this
+docstring.
+
+Why the files failed at all: `[tool.ruff] target-version = "py312"` lets the formatter
+split a long f-string *expression* across physical lines, which is PEP 701 syntax and
+parses on Python 3.12+ only:
+
+    f"[DRY RUN] Would compress & {
+        'remove' if remove_original else 'keep'
+    }: {input_path} -> {output_path}"
+
+The fix joins the expression back onto one line:
+
+  * the f-string's literal text is copied byte for byte
+  * inside {expressions}, a whitespace run containing a newline collapses to "" or " "
+    - a space is kept whenever two token-ish characters would otherwise merge, so
+      `'a'\nif x\nelse 'b'` becomes `'a' if x else 'b'` and never `'a'if xelse'b'`
+  * nested string literals inside an expression are copied byte for byte
+  * `{{` / `}}` escapes, string prefixes (r/b/u) and triple-quoted strings are handled
+
+Sites that would need anything fancier (a comment or a nested f-string inside an
+expression) raise Manual and the file is reported instead of being mangled - that is
+exactly what happened to html_template_gen/make_template_html.py, whose table-of-
+contents generator was a multi-line expression inside a *triple-quoted* f-string, and
+which was then fixed by hand (the generator moved out into a `toc` variable).
+
+Verification used with it: after the run, every diff was checked to be identical to
+its original once whitespace is stripped (see check_diff_whitespace_only.py), and
+`compileall` came back clean.
+
+Usage:
+    fix_pep701_fstrings.py [ROOT] [--check]     # --check reports without writing
+"""
+from __future__ import annotations
+
+import argparse
+import os
+import py_compile
+import sys
+import tempfile
+from pathlib import Path
+
+PREFIX_CHARS = "fFrRbBuU"
+QUOTES = "\"'"
+SKIP_DIRS = {".git", "__pycache__", "arena"}
+
+
+class Manual(Exception):
+    """This site needs a human; skip the file instead of guessing."""
+
+
+def prefix_at(s: str, i: int):
+    """-> (prefix, quote_index) if a string literal starts at i, else (None, i)."""
+    j = i
+    p = ""
+    while j < len(s) and s[j] in PREFIX_CHARS and len(p) < 3:
+        p += s[j]
+        j += 1
+    if p and j < len(s) and s[j] in QUOTES:
+        return p, j
+    return None, i
+
+
+def delim_at(s: str, qi: int) -> str:
+    q = s[qi]
+    return q * 3 if s[qi : qi + 3] == q * 3 else q
+
+
+def is_f(prefix: str) -> bool:
+    return "f" in prefix.lower()
+
+
+def is_raw(prefix: str) -> bool:
+    return "r" in prefix.lower()
+
+
+def scan_literal(s: str, i: int, on_newline=None):
+    """Scan the string literal starting at i; return the index past its delimiter.
+
+    `on_newline` fires for every raw newline inside an f-string *expression* - that is
+    the PEP 701-only bit we are looking for.
+    """
+    p, qi = prefix_at(s, i)
+    if p is None:
+        p, qi = "", i
+    delim = delim_at(s, qi)
+    fstr = is_f(p)
+    raw = is_raw(p)
+    j = qi + len(delim)
+    n = len(s)
+    while j < n:
+        c = s[j]
+        if not raw and c == "\\":
+            j += 2
+            continue
+        if s.startswith(delim, j):
+            return j + len(delim)
+        if fstr and c == "{":
+            if s.startswith("{{", j):
+                j += 2
+                continue
+            j = scan_expr(s, j, on_newline)
+            continue
+        if fstr and c == "}":
+            if s.startswith("}}", j):
+                j += 2
+                continue
+            return j + 1  # malformed; the compile check will catch it
+        if c == "\n" and len(delim) == 1 and not fstr:
+            return j  # unterminated plain string; bail out
+        j += 1
+    return n
+
+
+def scan_expr(s: str, j: int, on_newline=None):
+    """Scan the `{...}` of an f-string starting at j; return the index past `}`."""
+    n = len(s)
+    k = j + 1
+    depth = 1
+    while k < n:
+        c = s[k]
+        if c == "\n":
+            if on_newline is not None:
+                on_newline()
+            k += 1
+            continue
+        if c == "#":
+            raise Manual("comment inside f-string expression")
+        if c in QUOTES:
+            p, _qi = prefix_at(s, k)
+            if p is not None and is_f(p):
+                raise Manual("nested f-string inside f-string expression")
+            k = scan_literal(s, k, on_newline)
+            continue
+        if c in "([{":
+            depth += 1
+        elif c in ")]}":
+            depth -= 1
+            if depth == 0:
+                return k + 1
+        k += 1
+    return n
+
+
+def expr_text(s: str, start: int, end: int) -> str:
+    """The raw text between the braces of the expression at s[start:end]."""
+    inner_start = start + 1
+    k = inner_start
+    depth = 1
+    n = end - 1
+    while k < n:
+        c = s[k]
+        if c in QUOTES:
+            k = scan_literal(s, k)
+            continue
+        if c in "([{":
+            depth += 1
+        elif c in ")]}":
+            depth -= 1
+            if depth == 0:
+                return s[inner_start:k]
+        k += 1
+    return s[inner_start:n]
+
+
+WORDISH_BEFORE = set("_'\"`)]}")
+WORDISH_AFTER = set("_'\"([{`")
+
+
+def needs_space(prev: str, nxt: str) -> bool:
+    """Would removing the whitespace between these two characters merge two tokens?"""
+    if not prev or not nxt:
+        return False
+    pw = prev.isalnum() or prev in WORDISH_BEFORE
+    nw = nxt.isalnum() or nxt in WORDISH_AFTER
+    return pw and nw
+
+
+def join_expr(t: str) -> str:
+    out: list[str] = []
+    i = 0
+    n = len(t)
+    while i < n:
+        c = t[i]
+        if c in QUOTES:
+            k = scan_literal(t, i)
+            out.append(t[i:k])
+            i = k
+            continue
+        if c.isspace():
+            k = i
+            while k < n and t[k].isspace():
+                k += 1
+            run = t[i:k]
+            if "\n" in run:
+                prev = out[-1][-1] if out and out[-1] else ""
+                nxt = t[k] if k < n else ""
+                out.append(" " if needs_space(prev, nxt) else "")
+            else:
+                out.append(run)
+            i = k
+            continue
+        out.append(c)
+        i += 1
+    return "".join(out)
+
+
+def rebuild(seg: str) -> str:
+    """seg is one complete f-string literal; return it with its expressions joined."""
+    p, qi = prefix_at(seg, 0)
+    if p is None:
+        p, qi = "", 0
+    delim = delim_at(seg, qi)
+    body = seg[qi + len(delim) : len(seg) - len(delim)]
+    out: list[str] = []
+    j = 0
+    n = len(body)
+    while j < n:
+        c = body[j]
+        if c == "\\" and not is_raw(p):
+            out.append(body[j : j + 2])
+            j += 2
+            continue
+        if body.startswith("{{", j) or body.startswith("}}", j):
+            out.append(body[j : j + 2])
+            j += 2
+            continue
+        if c == "{":
+            k = scan_expr(body, j)
+            out.append("{" + join_expr(expr_text(body, j, k)) + "}")
+            j = k
+            continue
+        out.append(c)
+        j += 1
+    return p + delim + "".join(out) + delim
+
+
+def find_site(src: str):
+    """-> (start, end) offsets of the first multi-line f-string, or None."""
+    i = 0
+    n = len(src)
+    while i < n:
+        c = src[i]
+        if c == "#":
+            j = src.find("\n", i)
+            i = n if j < 0 else j
+            continue
+        p, _qi = prefix_at(src, i)
+        if p is not None or c in QUOTES:
+            start = i
+            hits: list[int] = []
+            end = scan_literal(src, i, on_newline=lambda: hits.append(1))
+            if hits and (p is not None and is_f(p) or p is None):
+                return start, end
+            i = max(end, i + 1)
+            continue
+        i += 1
+    return None
+
+
+def fix_file(path: str, write: bool = True) -> tuple[bool, int, str]:
+    src = open(path, encoding="utf-8").read()
+    changes = 0
+    for _ in range(40):
+        try:
+            site = find_site(src)
+        except Manual as e:
+            return False, changes, f"MANUAL: {e}"
+        if site is None:
+            break
+        start, end = site
+        try:
+            new = rebuild(src[start:end])
+        except Manual as e:
+            return False, changes, f"MANUAL: {e}"
+        if new == src[start:end]:
+            return False, changes, "MANUAL: no progress"
+        src = src[:start] + new + src[end:]
+        changes += 1
+    if changes and write:
+        open(path, "w", encoding="utf-8").write(src)
+    tmp = tempfile.mkdtemp()
+    try:
+        py_compile.compile(path, cfile=os.path.join(tmp, "x.pyc"), doraise=True)
+        return True, changes, ""
+    except Exception as e:  # noqa: BLE001
+        return False, changes, str(e).strip().splitlines()[-1][:120]
+
+
+def failing_files(root: Path) -> list[Path]:
+    tmp = tempfile.mkdtemp()
+    out = []
+    for p in sorted(root.rglob("*.py")):
+        if any(part in SKIP_DIRS for part in p.relative_to(root).parts):
+            continue
+        try:
+            py_compile.compile(str(p), cfile=os.path.join(tmp, "x.pyc"), doraise=True)
+        except Exception:
+            out.append(p)
+    return out
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(
+        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
+    )
+    ap.add_argument("root", nargs="?", type=Path, default=Path("."))
+    ap.add_argument("--check", action="store_true", help="report only, write nothing")
+    args = ap.parse_args()
+
+    targets = failing_files(args.root)
+    print(f"files failing to parse on Python {sys.version.split()[0]}: {len(targets)}")
+    bad = []
+    for path in targets:
+        ok, changes, msg = fix_file(str(path), write=not args.check)
+        print(f"  {'ok  ' if ok else 'FAIL'} {path} joins={changes} {msg}")
+        if not ok:
+            bad.append(path)
+    print(f"\nstill failing: {len(bad)}")
+    for path in bad:
+        print("   ", path)
+    if args.check:
+        print("(--check: nothing was written)")
+    return 1 if bad else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
