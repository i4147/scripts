diff --git a/run_external_formatter/run_formatter.py b/run_external_formatter/run_formatter.py
new file mode 100644
index 0000000..fb492df
--- /dev/null
+++ b/run_external_formatter/run_formatter.py
@@ -0,0 +1,180 @@
+#!/data/data/com.termux/files/home/.local/bin/python
+"""Run any external formatter/CLI over a set of files, in parallel.
+
+Merges the two scripts that lived in this folder:
+
+  forfin.py     `forfin.py .svg svgo -c config.json` - every *<ext> file in the
+                current directory, app args passed through, per-file report
+  fmt_bash.py   every .sh file *plus* extensionless files whose shebang mentions
+                bash/sh, searched recursively, binaries skipped, `shfmt -w`
+
+TARGET is either an extension (`.svg`) or the word `shell`, which selects the
+fmt_bash.py behaviour: every `.sh` file plus every *extensionless* file whose shebang
+matches --shebang, searched recursively, binaries skipped.
+
+Options for this script must come BEFORE the target; everything after APP is handed
+to APP verbatim, with the file path appended last.
+
+Usage: run_formatter.py [-w N] [-r|--no-recursive] [--skip-binary|--no-skip-binary]
+                        [--failures-only] TARGET APP [APP_ARGS...]
+
+Examples:
+  run_formatter.py .svg svgo -c config.json
+  run_formatter.py shell shfmt -w
+  run_formatter.py -w 4 --skip-binary .py black
+"""
+from __future__ import annotations
+
+import argparse
+import subprocess
+import sys
+from functools import partial
+from multiprocessing import Pool, cpu_count
+from pathlib import Path
+
+SKIP_DIRS = {".git", "__pycache__", "node_modules", ".venv"}
+
+
+def build_parser() -> argparse.ArgumentParser:
+    ap = argparse.ArgumentParser(
+        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
+    )
+    ap.add_argument(
+        "-w",
+        "--workers",
+        type=int,
+        default=0,
+        help="parallel workers (default: 75%% of the CPUs, minimum 1)",
+    )
+    ap.add_argument(
+        "-r",
+        "--recursive",
+        action="store_true",
+        help="search directories recursively (default for TARGET=shell)",
+    )
+    ap.add_argument(
+        "--no-recursive",
+        action="store_true",
+        help="only the current directory (default for an extension TARGET)",
+    )
+    ap.add_argument(
+        "--skip-binary",
+        action="store_true",
+        help="skip binary files (default for TARGET=shell)",
+    )
+    ap.add_argument(
+        "--no-skip-binary",
+        action="store_true",
+        help="do not skip binary files",
+    )
+    ap.add_argument(
+        "--shebang",
+        default="bash,sh",
+        help="comma separated words; an *extensionless* file matches TARGET=shell when "
+        "its shebang line contains one of them (default: bash,sh). Files that do have "
+        "an extension are selected by that extension instead (.sh always matches).",
+    )
+    ap.add_argument(
+        "--failures-only", action="store_true", help="print only the failed files"
+    )
+    ap.add_argument("target", help="extension like .svg, or the word 'shell'")
+    ap.add_argument("app", help="the CLI to run, e.g. svgo or shfmt")
+    ap.add_argument(
+        "app_args", nargs=argparse.REMAINDER, help="passed to APP before the file path"
+    )
+    return ap
+
+
+def is_binary(path: Path, chunk: int = 8192) -> bool:
+    try:
+        from dh import is_binary as dh_is_binary
+
+        return bool(dh_is_binary(path))
+    except Exception:
+        try:
+            with path.open("rb") as fh:
+                return b"\0" in fh.read(chunk)
+        except OSError:
+            return True
+
+
+def has_shell_shebang(path: Path, words: tuple[str, ...]) -> bool:
+    try:
+        with path.open("rb") as fh:
+            first = fh.readline(256).decode("utf-8", errors="ignore").strip()
+    except Exception:
+        return False
+    return first.startswith("#!") and any(w in first for w in words)
+
+
+def excluded(path: Path) -> bool:
+    return any(part in SKIP_DIRS for part in path.parts)
+
+
+def collect(args) -> list[Path]:
+    cwd = Path.cwd()
+    recursive = args.recursive or (args.target == "shell" and not args.no_recursive)
+    found: list[Path] = []
+    if args.target == "shell":
+        words = tuple(w.strip() for w in args.shebang.split(",") if w.strip())
+        walker = cwd.rglob("*") if recursive else cwd.glob("*")
+        for p in sorted(walker):
+            if not p.is_file() or p.is_symlink() or excluded(p):
+                continue
+            if p.suffix == ".sh" or (p.suffix == "" and has_shell_shebang(p, words)):
+                found.append(p)
+        return found
+    ext = args.target if args.target.startswith(".") else "." + args.target
+    pattern = f"**/*{ext}" if recursive else f"*{ext}"
+    for p in sorted(cwd.glob(pattern)):
+        if p.is_file() and not p.is_symlink() and not excluded(p):
+            found.append(p)
+    return found
+
+
+def process_file(cli_app: str, cli_args: list[str], path: Path) -> tuple[bool, str]:
+    try:
+        cmd = [cli_app, *cli_args, str(path)]
+        result = subprocess.run(cmd, capture_output=True, text=True)
+        if result.returncode == 0:
+            return True, f"✅ Processed: {path.name}"
+        return False, f"❌ Failed: {path.name} - {result.stderr.strip()}"
+    except Exception as e:
+        return False, f"❌ Error processing {path.name}: {e!s}"
+
+
+def main() -> int:
+    args = build_parser().parse_args()
+    skip_binary = (args.skip_binary or args.target == "shell") and not args.no_skip_binary
+    files = collect(args)
+    if skip_binary:
+        files = [p for p in files if not is_binary(p)]
+    if not files:
+        print(f"No {args.target} files found in {Path.cwd()}")
+        return 0
+
+    workers = args.workers or max(1, int(cpu_count() * 0.75))
+    print(f"Found {len(files)} file(s) in {Path.cwd()}")
+    print(f"Processing with: {args.app} {' '.join(args.app_args)}".rstrip())
+    print(f"Workers: {workers}")
+    print("-" * 40)
+
+    worker = partial(process_file, args.app, args.app_args)
+    with Pool(processes=workers) as pool:
+        results = pool.map(worker, files)
+
+    ok = sum(1 for success, _ in results if success)
+    failed_lines = [line for success, line in results if not success]
+    if not args.failures_only:
+        print("\n".join(line for _, line in results))
+        print("-" * 40)
+    if failed_lines:
+        print("\nFailed files:")
+        print("\n".join(failed_lines))
+    print("-" * 40)
+    print(f"Summary: {ok} successful, {len(results) - ok} failed")
+    return 0 if ok == len(results) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
