+#!/usr/bin/env python3
+"""Size and shape of the grouping: how many folders, how big, how much code in each.
+
+PROVENANCE: real - this is the exact snippet that was run to decide how to batch the
+one-script-per-folder merge (it produced "161 folders, 1204 scripts, 183,872 LOC,
+median 875 LOC per folder" and the smallest-first ordering that batch 1 followed).
+Changes since: it is wrapped in a main(), takes the root as an argument, skips the
+arena/ tooling directory, and uses sizes.get(2, 0) so it cannot KeyError once no
+two-member folders are left.
+
+Usage:
+    folder_stats.py [ROOT] [--top N] [--skip-merged]
+"""
+from __future__ import annotations
+
+import argparse
+import collections
+import os
+import statistics
+import sys
+from pathlib import Path
+
+SKIP = {".git", "__pycache__", "arena"}
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(
+        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
+    )
+    ap.add_argument("root", nargs="?", type=Path, default=Path("."))
+    ap.add_argument("--top", type=int, default=15)
+    ap.add_argument(
+        "--skip-merged",
+        action="store_true",
+        help="ignore folders that already hold a single merged script",
+    )
+    args = ap.parse_args()
+    root = args.root.resolve()
+
+    folders: dict[str, list[Path]] = {}
+    for d in sorted(os.listdir(root)):
+        p = root / d
+        if p.is_dir() and d not in SKIP:
+            pys = sorted(x for x in p.iterdir() if x.suffix == ".py")
+            if pys and not (args.skip_merged and len(pys) == 1):
+                folders[d] = pys
+
+    sizes = collections.Counter(len(v) for v in folders.values())
+    loc = {
+        d: sum(len(f.read_text(encoding="utf-8", errors="replace").splitlines()) for f in v)
+        for d, v in folders.items()
+    }
+
+    print(
+        "folder count:",
+        len(folders),
+        " scripts:",
+        sum(len(v) for v in folders.values()),
+        " total LOC:",
+        sum(loc.values()),
+    )
+    print("\nsize distribution (members -> #folders):")
+    for k in sorted(sizes):
+        print(f"   {k:3d} members: {sizes[k]:3d} folders")
+    print(f"\nfolders with 2 members: {sizes.get(2, 0)} -> quickest wins")
+
+    print(f"\n{args.top} biggest folders by LOC:")
+    for d, lines in sorted(loc.items(), key=lambda kv: -kv[1])[: args.top]:
+        print(f"   {lines:6d} LOC  {len(folders[d]):2d} scripts  {d}/")
+    print(f"\n{args.top} smallest folders by LOC:")
+    for d, lines in sorted(loc.items(), key=lambda kv: kv[1])[: args.top]:
+        print(f"   {lines:6d} LOC  {len(folders[d]):2d} scripts  {d}/")
+
+    if loc:
+        print(
+            f"\nmedian LOC/folder: {statistics.median(loc.values()):.0f}   "
+            f"mean: {statistics.mean(loc.values()):.0f}"
+        )
+    buckets = collections.Counter()
+    for _d, lines in loc.items():
+        buckets[
+            "<=300" if lines <= 300 else
+            "301-800" if lines <= 800 else
+            "801-2000" if lines <= 2000 else
+            ">2000"
+        ] += 1
+    print("LOC buckets:", dict(buckets))
+
+    remaining = sorted(loc.items(), key=lambda kv: kv[1])
+    if remaining:
+        nxt = remaining[:10]
+        print("\nNEXT BATCH (10 smallest remaining):")
+        for d, lines in nxt:
+            names = [f.name for f in folders[d]]
+            print(
+                f"  {lines:5d} LOC  {len(names):2d} scripts  {d}/  ->  "
+                f"{', '.join(names[:6])}{' …' if len(names) > 6 else ''}"
+            )
+        print(
+            f"\n  batch total: {sum(l for _, l in nxt)} LOC, "
+            f"{sum(len(folders[d]) for d, _ in nxt)} scripts"
+        )
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
