+#!/data/data/com.termux/files/home/.local/bin/python
+"""Merge a directory of small JSON dictionaries into one sorted dictionary file.
+
+Two directions are supported (replaces mfadic.py, the fa->en twin of this script):
+
+  en2fa (default)  {"english": "persian", ...} -> enfa.json  sorted case-insensitively
+  fa2en            {"persian": "english", ...} -> faen.json  sorted by code point
+
+Each source file is sampled before it is accepted: at least half of its first 5 keys
+must be in the source language and half of its first 5 values in the target language,
+otherwise the whole file is skipped and reported.  Individual entries whose key is not
+in the source language are skipped too.  Duplicate keys are collected and printed
+instead of being silently overwritten (the first value seen wins).  Source files that
+merged cleanly are deleted unless --keep is given.
+
+Usage: mendic.py [DIRECTORY] [OUTPUT.json] [-d/--direction en2fa|fa2en] [--keep]
+"""
+from __future__ import annotations
+
+import json
+import re
+import sys
+from collections import OrderedDict
+from pathlib import Path
+
+PERSIAN_RE = re.compile(r"[\u0600-\u06FF\u0750-\u077F\u08A0-\u08FF]")
+ENGLISH_RE = re.compile(r"[a-zA-Z]")
+
+
+def is_persian_word(word) -> bool:
+    return bool(PERSIAN_RE.search(str(word)))
+
+
+def is_english_word(word) -> bool:
+    return bool(ENGLISH_RE.search(str(word)))
+
+
+DIRECTIONS = {
+    "en2fa": {
+        "source": ("English", is_english_word),
+        "target": ("Persian", is_persian_word),
+        "default_output": "enfa.json",
+        "sort_key": lambda item: str(item[0]).lower(),
+    },
+    "fa2en": {
+        "source": ("Persian", is_persian_word),
+        "target": ("English", is_english_word),
+        "default_output": "faen.json",
+        "sort_key": None,
+    },
+}
+
+
+def check_file_format(data, cfg):
+    """-> (looks right, sample keys, sample values)"""
+    if not data or not isinstance(data, dict):
+        return False, [], []
+    sample_keys = list(data.keys())[:5]
+    sample_values = list(data.values())[:5]
+    _src_name, src_test = cfg["source"]
+    _tgt_name, tgt_test = cfg["target"]
+    src_keys = sum(1 for k in sample_keys if isinstance(k, str) and src_test(k))
+    tgt_values = sum(1 for v in sample_values if isinstance(v, str) and tgt_test(v))
+    is_correct = src_keys >= len(sample_keys) * 0.5 and tgt_values >= len(
+        sample_values
+    ) * 0.5
+    return is_correct, sample_keys, sample_values
+
+
+def merge_json_files(directory=".", output_file="enfa.json", direction="en2fa", keep=False):
+    cfg = DIRECTIONS[direction]
+    src_name, src_test = cfg["source"]
+    tgt_name, _tgt_test = cfg["target"]
+    merged_data = OrderedDict()
+    duplicate_keys = {}
+    skipped_files = []
+    file_count = 0
+    total_records = 0
+
+    json_files = sorted(Path(directory).glob("*.json"))
+    json_files = [f for f in json_files if f.name != output_file]
+    if not json_files:
+        print(f"No JSON files found in '{directory}'")
+        return
+    print(f"Found {len(json_files)} JSON file(s) to process")
+    print("=" * 40)
+
+    for json_file in json_files:
+        try:
+            with open(json_file, "r", encoding="utf-8") as f:
+                data = json.load(f)
+            if not isinstance(data, dict):
+                print(f"⚠️  Skipping {json_file.name}: Not a dictionary format")
+                skipped_files.append((json_file.name, "Not a dictionary"))
+                continue
+            is_correct_format, sample_keys, sample_values = check_file_format(data, cfg)
+            if not is_correct_format:
+                print(
+                    f"❌ Skipping {json_file.name}: Wrong format ({tgt_name} keys detected)"
+                )
+                print(f"   Sample keys: {sample_keys}")
+                print(f"   Sample values: {sample_values}")
+                skipped_files.append((json_file.name, f"Wrong format ({tgt_name} keys)"))
+                continue
+            file_count += 1
+            file_records = len(data)
+            total_records += file_records
+            print(f"✅ Processing: {json_file.name} ({file_records} records)")
+            for source_word, translation in data.items():
+                if not src_test(source_word):
+                    print(f"   ⚠️  Skipping entry '{source_word}': Key is not {src_name}")
+                    continue
+                if source_word in merged_data:
+                    duplicate_keys.setdefault(source_word, []).append(
+                        {
+                            "existing": merged_data[source_word],
+                            "duplicate": translation,
+                            "file": json_file.name,
+                        }
+                    )
+                else:
+                    merged_data[source_word] = translation
+            if not keep:
+                json_file.unlink()
+        except json.JSONDecodeError as e:
+            print(f"❌ Error parsing {json_file.name}: {e}")
+            skipped_files.append((json_file.name, f"JSON parsing error: {e}"))
+        except Exception as e:
+            print(f"❌ Error reading {json_file.name}: {e}")
+            skipped_files.append((json_file.name, f"Read error: {e}"))
+
+    print("\n" + "=" * 40)
+    print(f"💾 Saving merged data to {output_file}...")
+    sort_key = cfg["sort_key"]
+    items = sorted(merged_data.items(), key=sort_key) if sort_key else sorted(merged_data.items())
+    sorted_data = OrderedDict(items)
+    with open(output_file, "w", encoding="utf-8") as f:
+        json.dump(sorted_data, f, ensure_ascii=False, indent=2)
+
+    print("\n" + "=" * 40)
+    print("📊 MERGE REPORT")
+    print("=" * 40)
+    print(f"Direction: {direction} ({src_name} keys -> {tgt_name} values)")
+    print(f"Files processed successfully: {file_count}")
+    print(f"Files skipped: {len(skipped_files)}")
+    if skipped_files:
+        print("\n🚫 SKIPPED FILES:")
+        print("-" * 40)
+        for filename, reason in skipped_files:
+            print(f"  • {filename}: {reason}")
+    print(f"\nTotal records found (from valid files): {total_records}")
+    print(f"Unique records saved: {len(merged_data)}")
+    print(f"Duplicate keys found: {len(duplicate_keys)}")
+    if duplicate_keys:
+        print("\n🔍 DUPLICATE KEYS DETAILS:")
+        print("-" * 40)
+        for key, duplicates in duplicate_keys.items():
+            print(f"\nKey: '{key}'")
+            for dup in duplicates:
+                print(f"  • Existing: '{dup['existing']}'")
+                print(f"    Duplicate: '{dup['duplicate']}' (from {dup['file']})")
+    if merged_data:
+        print("\n📝 SAMPLE OF MERGED DATA:")
+        print("-" * 40)
+        for src_word, tgt_word in list(sorted_data.items())[:5]:
+            print(f"  '{src_word}': '{tgt_word}'")
+        if len(sorted_data) > 5:
+            print(f"  ... and {len(sorted_data) - 5} more entries")
+    if keep:
+        print("\nℹ️  Source files were kept (--keep).")
+    print("\n✅ Merge complete!")
+
+
+def main():
+    argv = sys.argv[1:]
+    direction = "en2fa"
+    keep = False
+    positional = []
+    i = 0
+    while i < len(argv):
+        arg = argv[i]
+        if arg in ("-d", "--direction"):
+            i += 1
+            direction = argv[i]
+        elif arg.startswith("--direction="):
+            direction = arg.split("=", 1)[1]
+        elif arg in ("-k", "--keep"):
+            keep = True
+        elif arg in ("-h", "--help"):
+            print(__doc__)
+            sys.exit(0)
+        else:
+            positional.append(arg)
+        i += 1
+    if direction not in DIRECTIONS:
+        print(f"❌ unknown direction '{direction}' (use: {', '.join(DIRECTIONS)})")
+        sys.exit(2)
+
+    directory = Path(positional[0]) if positional else Path.cwd()
+    output_file = (
+        positional[1] if len(positional) > 1 else DIRECTIONS[direction]["default_output"]
+    )
+    if not directory.exists():
+        print(f"❌ Directory '{directory}' does not exist.")
+        sys.exit(1)
+
+    print("🔄 Starting JSON merge process...")
+    print(f"📁 Source directory: {directory.resolve()}")
+    print(f"📄 Output file: {output_file}")
+    print("=" * 40)
+    merge_json_files(directory, output_file, direction=direction, keep=keep)
+
+
+if __name__ == "__main__":
+    main()
