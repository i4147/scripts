+#!/data/data/com.termux/files/home/.local/bin/python
+"""Clean a wordlist in place: drop junk lines and pull out near-duplicates.
+
+Merges the two scripts that lived in this folder:
+
+  clean_wordlist.py       finds words that differ from another word by exactly one
+                          character (single-position wildcard buckets), appends them
+                          to similar.txt and rewrites the list without them; uses
+                          mmap above 5 MB
+  clean_wordlist_fast.py  streaming filter that drops single-character-repeated lines
+                          ("aaaa", "777777") through a temp file, then renames it over
+                          the original
+
+Usage: wordlist_filter.py FILE [options]
+
+  --mode both|repeats|similar   which clean-ups to run (default: both)
+  --similar-out FILE            where near-duplicates go (default: similar.txt)
+  --overwrite-similar           truncate that file instead of appending
+  --out FILE                    write the cleaned list here instead of in place
+  --mmap-threshold BYTES        switch to mmap above this size (default: 5242880)
+  --min-length N                ignore words shorter than N for the similar scan
+  --dry-run                     report what would change, write nothing
+  --quiet                       no [Info]/[Success] chatter
+"""
+from __future__ import annotations
+
+import argparse
+import contextlib
+import mmap
+import os
+import re
+import sys
+import tempfile
+from collections import defaultdict
+from pathlib import Path
+
+RE_REPEAT = re.compile(r"^(.)\1+$", re.IGNORECASE)
+DEFAULT_THRESHOLD = 5 * 1024 * 1024
+
+
+def build_parser() -> argparse.ArgumentParser:
+    ap = argparse.ArgumentParser(
+        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
+    )
+    ap.add_argument("file", type=Path)
+    ap.add_argument("--mode", choices=("both", "repeats", "similar"), default="both")
+    ap.add_argument("--similar-out", type=Path, default=Path("similar.txt"))
+    ap.add_argument("--overwrite-similar", action="store_true")
+    ap.add_argument("--out", type=Path, default=None)
+    ap.add_argument("--mmap-threshold", type=int, default=DEFAULT_THRESHOLD)
+    ap.add_argument("--min-length", type=int, default=1)
+    ap.add_argument("--dry-run", action="store_true")
+    ap.add_argument("--quiet", action="store_true")
+    return ap
+
+
+def say(args, message: str) -> None:
+    if not args.quiet:
+        print(message)
+
+
+def get_lines(path: Path, threshold: int, args) -> list[str]:
+    file_size = path.stat().st_size
+    if file_size > threshold:
+        say(
+            args,
+            f"[Info] Large file detected ({file_size / (1024 * 1024):.2f} MB). Using mmap...",
+        )
+        with (
+            path.open("r+b") as fh,
+            mmap.mmap(fh.fileno(), 0, access=mmap.ACCESS_READ) as mm,
+        ):
+            content = mm.read().decode("utf-8", errors="ignore")
+            return [line.strip() for line in content.splitlines() if line.strip()]
+    say(args, "[Info] Small file detected. Using standard read...")
+    with path.open("r", encoding="utf-8", errors="ignore") as fh:
+        return [line.strip() for line in fh if line.strip()]
+
+
+def split_repeats(lines: list[str]) -> tuple[list[str], list[str]]:
+    """-> (kept, dropped single-character-repeated lines)"""
+    kept, dropped = [], []
+    for line in lines:
+        (dropped if RE_REPEAT.fullmatch(line) else kept).append(line)
+    return kept, dropped
+
+
+def find_similar(lines: list[str], min_length: int) -> set[str]:
+    """Words that collide on a single-position wildcard, e.g. pass and pass1."""
+    buckets: dict[str, list[str]] = defaultdict(list)
+    for word in lines:
+        if len(word) < min_length:
+            continue
+        for i in range(len(word)):
+            buckets[word[:i] + "*" + word[i + 1 :]].append(word)
+    similar: set[str] = set()
+    for matched in buckets.values():
+        if len(matched) > 1:
+            similar.update(matched)
+    return similar
+
+
+def write_atomic(dest: Path, lines: list[str]) -> None:
+    fd, tmp_name = tempfile.mkstemp(
+        prefix=f".{dest.name}.", suffix=".tmp", dir=str(dest.parent or ".")
+    )
+    tmp = Path(tmp_name)
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8", errors="ignore") as fh:
+            for line in lines:
+                fh.write(line + "\n")
+        tmp.replace(dest)
+    except Exception:
+        if tmp.exists():
+            with contextlib.suppress(OSError):
+                tmp.unlink()
+        raise
+
+
+def main() -> int:
+    args = build_parser().parse_args()
+    path = args.file
+    if not path.exists():
+        print(f"Error: file '{path}' does not exist.", file=sys.stderr)
+        return 1
+
+    lines = get_lines(path, args.mmap_threshold, args)
+    original_count = len(lines)
+
+    dropped_repeats: list[str] = []
+    if args.mode in ("both", "repeats"):
+        lines, dropped_repeats = split_repeats(lines)
+
+    similar: set[str] = set()
+    if args.mode in ("both", "similar"):
+        similar = find_similar(lines, args.min_length)
+    remaining = [line for line in lines if line not in similar]
+
+    say(args, f"[Info] {original_count} lines read")
+    if dropped_repeats:
+        say(args, f"[Info] {len(dropped_repeats)} repeated-character line(s) dropped")
+    if similar:
+        say(args, f"[Info] {len(similar)} near-duplicate line(s) matched")
+        if not args.quiet:
+            print("-" * 40)
+            for line in sorted(similar)[:40]:
+                print(f"  {line}")
+            if len(similar) > 40:
+                print(f"  ... and {len(similar) - 40} more")
+            print("-" * 40)
+    else:
+        say(args, "No similar items found.")
+
+    if args.dry_run:
+        say(args, "[Dry run] nothing written")
+        return 0
+
+    if similar:
+        mode = "w" if args.overwrite_similar else "a"
+        with args.similar_out.open(mode, encoding="utf-8") as sf:
+            for line in sorted(similar):
+                sf.write(line + "\n")
+        say(args, f"[Success] Moved {len(similar)} lines to {args.similar_out}")
+
+    dest = args.out or path
+    write_atomic(dest, remaining)
+    say(args, f"[Success] Updated {dest} in-place ({len(remaining)} lines remaining).")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
