@@ -0,0 +1,85 @@
+#!/usr/bin/env python3
+"""List the files that the running interpreter cannot parse.
+
+PROVENANCE: real logic, extracted from the loop that found the 31 Python-3.11
+failures.  One gotcha cost a false report the first time it was run: passing
+`cfile=os.devnull` to py_compile.compile() makes *every* file look like a failure
+(all 1222 of them), because the .pyc cannot be written to /dev/null.  The cfile has to
+be a real writable path - a temp dir works.
+
+`python3 -m compileall -q .` is the quicker way to get the same answer; this script
+exists because it also classifies the failures and prints the offending source line,
+which is how the "all 31 are PEP 701 f-strings" conclusion was reached.
+
+Usage:
+    compile_check.py [ROOT] [--show-line] [--kind-summary]
+"""
+from __future__ import annotations
+
+import argparse
+import collections
+import os
+import py_compile
+import re
+import sys
+import tempfile
+from pathlib import Path
+
+SKIP_DIRS = {".git", "__pycache__", "arena"}
+
+
+def check(root: Path, show_line: bool, kind_summary: bool) -> int:
+    tmp = tempfile.mkdtemp()
+    cfile = os.path.join(tmp, "x.pyc")
+    total = 0
+    failures = []
+    for path in sorted(root.rglob("*.py")):
+        if any(part in SKIP_DIRS for part in path.relative_to(root).parts):
+            continue
+        total += 1
+        try:
+            py_compile.compile(str(path), cfile=cfile, doraise=True)
+        except Exception as e:  # noqa: BLE001
+            failures.append((path, str(e)))
+
+    print(f"checked {total} files with Python {sys.version.split()[0]}")
+    print(f"FAILED: {len(failures)}")
+
+    kinds = collections.Counter()
+    for path, msg in failures:
+        m = re.search(r"line (\d+)\n(.*?)\n\s*\^\s*\n(\w*Error: [^\n]*)", msg, re.S)
+        lineno = int(m.group(1)) if m else 0
+        err = m.group(3) if m else msg.strip().splitlines()[-1]
+        src = ""
+        try:
+            src = path.read_text(encoding="utf-8", errors="replace").splitlines()[lineno - 1].strip()
+        except Exception:
+            pass
+        nested_f = 'f"' in src or "f'" in src
+        kinds[(err.split(":")[0], "nested-quote f-string" if nested_f else err.split(": ", 1)[-1][:38])] += 1
+        print(f"  {str(path.relative_to(root)):56s} L{lineno:<5d} {err[:44]:46s}", end="")
+        if show_line:
+            print(f" | {src[:64]}")
+        else:
+            print()
+
+    if kind_summary and kinds:
+        print("\nKIND SUMMARY:")
+        for (name, kind), count in kinds.most_common():
+            print(f"   {count:4d}  {name}: {kind}")
+    return 1 if failures else 0
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(
+        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
+    )
+    ap.add_argument("root", nargs="?", type=Path, default=Path("."))
+    ap.add_argument("--show-line", action="store_true")
+    ap.add_argument("--kind-summary", action="store_true")
+    args = ap.parse_args()
+    return check(args.root.resolve(), args.show_line, args.kind_summary)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/arena/02_merge/extract_fstring_regions.py b/arena/02_merge/extract_fstring_regions.py
