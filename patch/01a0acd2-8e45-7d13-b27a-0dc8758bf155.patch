@@ -0,0 +1,136 @@
+#!/usr/bin/env python3
+"""Check the post-conditions of the folderize + merge steps.
+
+PROVENANCE: reconstructed from the checks that were run after every commit in this
+job (they were one-liners in bash; this collects them and adds a few more).
+
+Verified:
+  * script and folder counts, plus the 5 singletons that must stay in the root
+  * no folder holds fewer than two scripts (the rule for step 1) - or, with
+    --expect-merged, every folder holds exactly one merged script (the goal of step 2)
+  * no extension-less symlinks are left anywhere
+  * every .py file parses with the running interpreter
+  * no file is empty, no folder is empty, no stray __pycache__
+
+Usage:
+    verify_layout.py [ROOT] [--expect-merged] [--min-members N]
+"""
+from __future__ import annotations
+
+import argparse
+import py_compile
+import sys
+import tempfile
+from pathlib import Path
+
+SKIP_DIRS = {".git", "__pycache__", "arena"}
+EXPECTED_ROOT_SINGLETONS = {
+    "cli_wrapper.py",
+    "fix_html_md_broken_links.py",
+    "gitignore_updater.py",
+    "rm_from_archive.py",
+    "update_summary.py",
+}
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(
+        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
+    )
+    ap.add_argument("root", nargs="?", type=Path, default=Path("."))
+    ap.add_argument("--expect-merged", action="store_true",
+                    help="every folder must hold exactly one merged script")
+    ap.add_argument("--min-members", type=int, default=2)
+    args = ap.parse_args()
+    root = args.root.resolve()
+
+    problems: list[str] = []
+    folders: dict[str, list[Path]] = {}
+    root_scripts: list[Path] = []
+    symlinks: list[Path] = []
+    empty_files: list[Path] = []
+    caches: list[Path] = []
+
+    for entry in sorted(root.iterdir()):
+        if entry.name == "__pycache__":
+            caches.append(entry)
+        if entry.name in SKIP_DIRS:
+            continue
+        if entry.is_symlink():
+            symlinks.append(entry)
+        elif entry.is_dir():
+            pys = sorted(p for p in entry.rglob("*.py"))
+            folders[entry.name] = pys
+            if not pys:
+                problems.append(f"empty folder: {entry.name}/")
+            for p in entry.rglob("__pycache__"):
+                caches.append(p)
+        elif entry.suffix == ".py":
+            root_scripts.append(entry)
+
+    all_scripts = [p for pys in folders.values() for p in pys] + root_scripts
+    for p in all_scripts:
+        if p.stat().st_size == 0:
+            empty_files.append(p)
+
+    print(f"folders        : {len(folders)}")
+    print(f"grouped scripts: {sum(len(v) for v in folders.values())}")
+    print(f"root scripts   : {len(root_scripts)} -> {', '.join(p.name for p in root_scripts)}")
+    print(f"total scripts  : {len(all_scripts)}")
+    print(f"symlinks       : {len(symlinks)}")
+    print(f"empty files    : {len(empty_files)}")
+    print(f"__pycache__    : {len(caches)}")
+
+    if symlinks:
+        problems.append(f"{len(symlinks)} symlink(s) left, e.g. {symlinks[0].name}")
+    if empty_files:
+        problems.append(f"{len(empty_files)} empty file(s), e.g. {empty_files[0]}")
+    if caches:
+        problems.append(f"{len(caches)} __pycache__ dir(s) committed, e.g. {caches[0]}")
+
+    unexpected_root = {p.name for p in root_scripts} - EXPECTED_ROOT_SINGLETONS
+    if unexpected_root and not args.expect_merged:
+        problems.append(f"unexpected root scripts: {sorted(unexpected_root)}")
+
+    if args.expect_merged:
+        bad = {name: len(pys) for name, pys in folders.items() if len(pys) != 1}
+        print(f"folders not yet merged to one script: {len(bad)}")
+        for name, n in sorted(bad.items(), key=lambda kv: -kv[1])[:15]:
+            print(f"    {name}/ still has {n}")
+    else:
+        small = {
+            name: len(pys)
+            for name, pys in folders.items()
+            if 0 < len(pys) < args.min_members
+        }
+        if small:
+            problems.append(
+                f"{len(small)} folder(s) below {args.min_members} members: "
+                + ", ".join(sorted(small)[:8])
+            )
+
+    tmp = tempfile.mkdtemp()
+    failing = []
+    for p in all_scripts:
+        try:
+            py_compile.compile(str(p), cfile=str(Path(tmp) / "x.pyc"), doraise=True)
+        except Exception as e:
+            failing.append((p, str(e).strip().splitlines()[-1][:100]))
+    print(f"parse failures : {len(failing)} (Python {sys.version.split()[0]})")
+    for p, msg in failing[:10]:
+        print(f"    {p.relative_to(root)}: {msg}")
+    if failing:
+        problems.append(f"{len(failing)} file(s) do not parse")
+
+    print()
+    if problems:
+        print("PROBLEMS:")
+        for problem in problems:
+            print(f"  ✗ {problem}")
+        return 1
+    print("✓ layout OK")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
