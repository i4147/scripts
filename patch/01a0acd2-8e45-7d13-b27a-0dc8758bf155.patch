+#!/data/data/com.termux/files/home/.local/bin/python
+"""Convert HTML files to Markdown, keeping only the main article content.
+
+readability-lxml extracts the article body first, then one of two converters renders
+it as Markdown:
+
+  html2text    (default) links, images and tables kept; body_width=0 (no wrapping)
+  markdownify  alternative engine, stays closer to the original HTML whitespace
+
+Replaces tomd.py, which was this script with markdownify swapped in for html2text.
+The source .html is deleted after a successful conversion unless --keep is given, and
+an existing .md next to the source is never overwritten.
+
+Usage: html_to_md.py [FILE.html ...] [--engine html2text|markdownify] [--keep]
+With no file arguments every .html/.htm/.xhtml/.xhtm under the current directory is
+converted in parallel.
+"""
+from __future__ import annotations
+
+import sys
+from functools import partial
+from pathlib import Path
+
+from dh import get_files, mpf3
+from readability import Document
+
+HTML_EXTS = [".html", ".htm", ".xhtml", ".xhtm"]
+ENGINES = ("html2text", "markdownify")
+
+
+def to_markdown(html: str, engine: str) -> str:
+    if engine == "markdownify":
+        from markdownify import markdownify as md
+
+        return md(html)
+    import html2text
+
+    handler = html2text.HTML2Text()
+    handler.ignore_links = False
+    handler.ignore_images = False
+    handler.ignore_tables = False
+    handler.body_width = 0
+    return handler.handle(html)
+
+
+def process_file(path, engine: str = "html2text", keep: bool = False):
+    """-> (written path, ok)"""
+    path = Path(path)
+    md_file = path.with_suffix(".md")
+    if md_file.exists():
+        return (md_file, True)
+    try:
+        html_content = path.read_text(encoding="utf-8", errors="ignore")
+        main_content = Document(html_content).summary()
+        markdown = to_markdown(main_content, engine)
+        if markdown and markdown.strip():
+            md_file.write_text(markdown, encoding="utf-8")
+            print(f"✓ Converted: {path.name} -> {md_file.name}")
+            if not keep:
+                path.unlink()
+            return (md_file, True)
+        print(f"✗ No content extracted from {path.name}")
+        return (path, False)
+    except Exception as e:
+        print(f"✗ Error: {e}")
+        return (path, False)
+
+
+def parse_args(argv: list[str]) -> tuple[list[Path], str, bool]:
+    engine = "html2text"
+    keep = False
+    files = []
+    i = 0
+    while i < len(argv):
+        arg = argv[i]
+        if arg in ("-e", "--engine"):
+            i += 1
+            engine = argv[i]
+        elif arg.startswith("--engine="):
+            engine = arg.split("=", 1)[1]
+        elif arg in ("-k", "--keep"):
+            keep = True
+        elif arg in ("-h", "--help"):
+            print(__doc__)
+            raise SystemExit(0)
+        else:
+            files.append(Path(arg))
+        i += 1
+    if engine not in ENGINES:
+        print(f"✗ unknown engine '{engine}' (use: {', '.join(ENGINES)})")
+        raise SystemExit(2)
+    return files, engine, keep
+
+
+def main() -> None:
+    files, engine, keep = parse_args(sys.argv[1:])
+    if not files:
+        files = get_files(Path.cwd(), ext=HTML_EXTS)
+    if not files:
+        print("No HTML files found to convert.")
+        return
+    worker = partial(process_file, engine=engine, keep=keep)
+    if len(files) == 1:
+        process_file(files[0], engine=engine, keep=keep)
+        return
+    mpf3(worker, files)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
