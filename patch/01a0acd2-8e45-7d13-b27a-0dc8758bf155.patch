@@ -0,0 +1,78 @@
+#!/usr/bin/env python3
+"""Print the exact source region of every f-string that the interpreter cannot parse.
+
+PROVENANCE: real - this produced /tmp/fregions.txt, the dump that showed all 31
+failures were the same shape (an f-string *expression* split over several physical
+lines) and therefore fixable mechanically.  It reuses the scanner from
+fix_pep701_fstrings.py so the region it prints is the region that script rewrites.
+
+Usage:
+    extract_fstring_regions.py [ROOT] [-o regions.txt] [--context N]
+"""
+from __future__ import annotations
+
+import argparse
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+from fix_pep701_fstrings import (  # noqa: E402
+    Manual,
+    find_site,
+    failing_files,
+)
+
+
+def regions(path: Path, context: int) -> list[str]:
+    src = path.read_text(encoding="utf-8", errors="replace")
+    lines = src.splitlines()
+    out = []
+    cursor = 0
+    while True:
+        try:
+            site = find_site(src[cursor:])
+        except Manual as e:
+            out.append(f"  !! manual fix needed: {e}")
+            break
+        if site is None:
+            break
+        start, end = site
+        abs_start = cursor + start
+        first_line = src.count("\n", 0, abs_start)
+        last_line = src.count("\n", 0, cursor + end)
+        out.append(f"  region lines {first_line + 1}-{last_line + 1}")
+        for k in range(max(0, first_line - context), min(len(lines), last_line + context + 1)):
+            mark = ">>" if first_line <= k <= last_line else "  "
+            out.append(f"{mark}{k + 1:5d}| {lines[k]}")
+        cursor += end
+    return out
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(
+        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
+    )
+    ap.add_argument("root", nargs="?", type=Path, default=Path("."))
+    ap.add_argument("-o", "--output", type=Path, default=None)
+    ap.add_argument("--context", type=int, default=1)
+    args = ap.parse_args()
+
+    targets = failing_files(args.root.resolve())
+    blocks = [f"files that do not parse: {len(targets)}\n"]
+    for path in targets:
+        blocks.append(f"########## {path}")
+        found = regions(path, args.context)
+        blocks.extend(found or ["  (no multi-line f-string found - different cause)"])
+        blocks.append("")
+    text = "\n".join(blocks)
+    if args.output:
+        args.output.write_text(text, encoding="utf-8")
+        print(f"wrote {args.output} ({len(targets)} files)")
+    else:
+        print(text)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
