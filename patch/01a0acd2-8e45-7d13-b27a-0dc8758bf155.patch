+#!/usr/bin/env bash
+# Assertion battery for the merged scripts of batch 1 (the 8 smallest folders).
+#
+# PROVENANCE: real - these are the checks that were run against the batch-1 merges
+# (~110 assertions over three runs).  They found two real bugs, both fixed:
+#   * archive_and_clean.py --exclude resolved against the cwd instead of the archived
+#     directory, so the "protected" file was deleted anyway
+#   * pickle_convert.py --report was silenced by --quiet; an explicit --report now wins
+# Everything else that failed was a wrong expectation in the test itself, and the
+# corrected version is what is saved here:
+#   * the merge_css runs each needed a fresh directory - earlier outputs are .css files
+#     too, so run N merged the output of run N-1 and the banner counts looked wrong
+#   * the wordlist near-duplicate scan only matches words of EQUAL length differing in
+#     one position (pass/piss, word/wore); pass/passe can never collide
+#   * similar.txt appends across runs by design, and --overwrite-similar only
+#     truncates when there is something to write (no silent data loss)
+#   * TARGET=shell always takes .sh files; --shebang only governs extensionless ones
+#
+# qr_decode.py and telegram_link_scraper.py are NOT covered: PIL/pyzbar and telethon
+# are not installed in the sandbox, so they were syntax-checked only.
+#
+# Usage: test_merged_scripts.sh [REPO_ROOT]     (runs entirely inside a temp dir)
+set -uo pipefail
+B="$(cd "${1:-/home/user/bin_sep}" 2>/dev/null && pwd)" || { echo "repo root not found: ${1:-/home/user/bin_sep}" >&2; exit 2; }
+W="$(mktemp -d)"
+cd "$W" || exit 1
+pass=0; fail=0
+ck(){ if [ "$2" = "$3" ]; then pass=$((pass+1)); echo "  PASS $1"; else fail=$((fail+1)); echo "  FAIL $1 (got '$2' want '$3')"; fi; }
+has(){ if echo "$2" | grep -q "$3"; then pass=$((pass+1)); echo "  PASS $1"; else fail=$((fail+1)); echo "  FAIL $1"; fi; }
+
+echo "########## merge_css.py (fresh sources for every run)"
+setup(){ rm -rf c; mkdir -p c/sub
+  printf '@charset "utf-8";\n@import url(https://fonts.googleapis.com/css?family=Lato);\n.a{color:red}\n' > c/a.css
+  printf '.b{font-family:Lato}\n@font-face{src:url("https://cdn.x.com/fonts/lato.woff2")}\n' > c/b.css
+  printf '.c{margin:0}\n' > c/sub/c.css; }
+setup; (cd c && python3 "$B/merge_css_files/merge_css.py" . -o out.css >/dev/null 2>&1)
+ck "output written" "$([ -f c/out.css ] && echo y)" "y"
+ck "googleapis @import stripped" "$(grep -c googleapis c/out.css)" "0"
+ck "font url localized" "$(grep -c '/sdcard/_static/fonts/lato.woff2' c/out.css)" "1"
+ck "charset hoisted to line 1" "$(head -1 c/out.css)" '@charset "utf-8";'
+ck "charset appears once" "$(grep -c '@charset' c/out.css)" "1"
+ck "recursive descent found sub/c.css" "$(grep -c '===== c.css =====' c/out.css)" "1"
+ck "one banner per source" "$(grep -c '=====' c/out.css)" "3"
+ck "the output is never merged into itself" "$(grep -c '===== out.css' c/out.css)" "0"
+setup; (cd c && python3 "$B/merge_css_files/merge_css.py" . -o out.css --no-banner >/dev/null 2>&1)
+ck "--no-banner" "$(grep -c '=====' c/out.css)" "0"
+ck "--no-banner still merged both sources" "$(grep -c 'color:red\|font-family:Lato' c/out.css)" "2"
+setup; (cd c && python3 "$B/merge_css_files/merge_css.py" . -o out.css --no-recursive >/dev/null 2>&1)
+ck "--no-recursive skips sub/" "$(grep -c 'margin:0' c/out.css)" "0"
+setup; (cd c && python3 "$B/merge_css_files/merge_css.py" a.css b.css -o out.css >/dev/null 2>&1)
+ck "explicit file list" "$(grep -c '=====' c/out.css)" "2"
+setup; (cd c && python3 "$B/merge_css_files/merge_css.py" . -o out.css --exclude b.css >/dev/null 2>&1)
+ck "--exclude skips a source" "$(grep -c '===== b.css' c/out.css)" "0"
+setup; (cd c && python3 "$B/merge_css_files/merge_css.py" . -o out.css --no-localize-fonts >/dev/null 2>&1)
+ck "--no-localize-fonts" "$(grep -c 'cdn.x.com' c/out.css)" "1"
+setup; (cd c && python3 "$B/merge_css_files/merge_css.py" . -o out.css --no-charset >/dev/null 2>&1)
+ck "--no-charset drops it" "$(grep -c '@charset' c/out.css)" "0"
+setup; (cd c && python3 "$B/merge_css_files/merge_css.py" . -o out.css --font-dir /my/fonts >/dev/null 2>&1)
+ck "--font-dir honoured" "$(grep -c '/my/fonts/' c/out.css)" "1"
+mkdir -p empty; (cd empty && python3 "$B/merge_css_files/merge_css.py" . >/dev/null 2>&1); ck "no css found -> exit 1" "$?" "1"
+has "--engine cleancss reports a missing CLI cleanly" \
+  "$(cd c && python3 "$B/merge_css_files/merge_css.py" . -o out.css --engine cleancss 2>&1)" "is not installed"
+
+echo "########## wordlist_filter.py"
+mkdir -p wl && cd wl || exit 1
+printf 'aaaa\npass\npiss\nhello\n777777\nword\nwore\nunique1\n' > l.txt
+python3 "$B/wordlist_clean/wordlist_filter.py" l.txt --quiet --dry-run >/dev/null 2>&1
+ck "--dry-run writes nothing" "$(wc -l < l.txt)" "8"
+ck "--dry-run creates no similar.txt" "$([ -f similar.txt ] && echo y || echo n)" "n"
+python3 "$B/wordlist_clean/wordlist_filter.py" l.txt --quiet --mode repeats >/dev/null 2>&1
+ck "mode=repeats dropped the 2 junk lines" "$(wc -l < l.txt)" "6"
+ck "mode=repeats touches no similar.txt" "$([ -f similar.txt ] && echo y || echo n)" "n"
+printf 'aaaa\npass\npiss\nhello\n777777\nword\nwore\nunique1\n' > l2.txt
+python3 "$B/wordlist_clean/wordlist_filter.py" l2.txt --quiet --mode similar >/dev/null 2>&1
+ck "one-char twins found (pass/piss, word/wore)" "$(sort similar.txt | tr '\n' ' ')" "pass piss word wore "
+ck "twins removed from the list" "$(grep -c 'pass\|piss\|word\|wore' l2.txt)" "0"
+ck "repeats kept in similar-only mode" "$(grep -c 'aaaa' l2.txt)" "1"
+printf 'aaaa\npass\npiss\nhello\n777777\nword\nwore\nunique1\n' > l3.txt
+python3 "$B/wordlist_clean/wordlist_filter.py" l3.txt --quiet >/dev/null 2>&1
+ck "mode=both leaves only the uniques" "$(sort l3.txt | tr '\n' ' ')" "hello unique1 "
+python3 "$B/wordlist_clean/wordlist_filter.py" l3.txt --quiet --overwrite-similar >/dev/null 2>&1
+ck "--overwrite-similar keeps old content when nothing matched (4 from --mode similar + 4 from mode=both)" "$(wc -l < similar.txt)" "8"
+printf 'aaaa\ncat\nbat\nhat\nzzzz\n' > l4.txt
+python3 "$B/wordlist_clean/wordlist_filter.py" l4.txt --quiet --overwrite-similar >/dev/null 2>&1
+ck "--overwrite-similar replaces previous content" "$(sort similar.txt | tr '\n' ' ')" "bat cat hat "
+python3 "$B/wordlist_clean/wordlist_filter.py" l4.txt --quiet --out other.txt >/dev/null 2>&1
+ck "--out writes elsewhere" "$([ -f other.txt ] && echo y)" "y"
+python3 "$B/wordlist_clean/wordlist_filter.py" l4.txt --quiet --min-length 4 --mode similar >/dev/null 2>&1
+ck "--min-length skips short words" "$?" "0"
+python3 "$B/wordlist_clean/wordlist_filter.py" missing.txt --quiet >/dev/null 2>&1; ck "missing file -> exit 1" "$?" "1"
+cd "$W" || exit 1
+
+echo "########## archive_and_clean.py"
+mk(){ rm -rf "$1"; mkdir -p "$1/sub"; echo x > "$1/a.txt"; echo y > "$1/sub/b.txt"; }
+mk e0; python3 "$B/archive_create/archive_and_clean.py" e0 --dry-run 2>&1 | grep -q "would archive" \
+  && { pass=$((pass+1)); echo "  PASS --dry-run announces itself"; } || { fail=$((fail+1)); echo "  FAIL --dry-run"; }
+ck "dry-run wrote no archive" "$(ls e0*.tar.gz 2>/dev/null | wc -l)" "0"
+mk e1; python3 "$B/archive_create/archive_and_clean.py" e1 --keep >/dev/null 2>&1
+ck "--keep made the archive" "$([ -f e1.tar.gz ] && echo y)" "y"
+ck "--keep kept the contents" "$(ls e1 | wc -l)" "2"
+ck "archive holds both files" "$(tar tzf e1.tar.gz | grep -c 'a.txt\|b.txt')" "2"
+mk e2; python3 "$B/archive_create/archive_and_clean.py" e2 --format tar >/dev/null 2>&1
+ck "--format tar" "$([ -f e2.tar ] && echo y)" "y"
+ck "default removes contents, keeps the dir" "$([ -d e2 ] && echo "$(ls -A e2 | wc -l)")" "0"
+mk e3; python3 "$B/archive_create/archive_and_clean.py" e3 --remove-dir >/dev/null 2>&1
+ck "--remove-dir deleted the directory" "$([ -d e3 ] && echo y || echo n)" "n"
+ck "--remove-dir kept the archive" "$([ -f e3.tar.gz ] && echo y)" "y"
+mk e4; python3 "$B/archive_create/archive_and_clean.py" e4 --exclude a.txt >/dev/null 2>&1
+ck "--exclude protects a top-level file" "$(ls e4 | tr '\n' ' ')" "a.txt "
+mk e5; python3 "$B/archive_create/archive_and_clean.py" e5 --exclude sub >/dev/null 2>&1
+ck "--exclude protects a subdirectory" "$(ls e5 | tr '\n' ' ')" "sub "
+mk e6; python3 "$B/archive_create/archive_and_clean.py" e6 --exclude "$W/e6/a.txt" >/dev/null 2>&1
+ck "--exclude accepts an absolute path" "$(ls e6 | tr '\n' ' ')" "a.txt "
+mk e7; python3 "$B/archive_create/archive_and_clean.py" e7 --remove-dir --exclude a.txt >/dev/null 2>&1
+ck "--remove-dir + --exclude is rejected" "$?" "2"
+ck "and nothing was deleted" "$(ls e7 | wc -l)" "2"
+mk e8; python3 "$B/archive_create/archive_and_clean.py" e8 --format zip >/dev/null 2>&1
+ck "zip holds the 2 files" "$(python3 -c "import zipfile;z=zipfile.ZipFile('e8.zip');print(sum(1 for i in z.infolist() if not i.is_dir()))")" "2"
+ck "zip arcnames keep the folder name" "$(python3 -c "import zipfile;print(sorted(n for n in zipfile.ZipFile('e8.zip').namelist() if not n.endswith('/'))[0])")" "e8/a.txt"
+mk e9; python3 "$B/archive_create/archive_and_clean.py" e9 --workers 1 >/dev/null 2>&1
+ck "--workers 1 deletes serially" "$([ -d e9 ] && echo "$(ls -A e9 | wc -l)")" "0"
+mk ea; python3 "$B/archive_create/archive_and_clean.py" ea --dry-run --exclude a.txt 2>&1 | grep -q "leave alone: a.txt" \
+  && { pass=$((pass+1)); echo "  PASS dry-run reports exclusions"; } || { fail=$((fail+1)); echo "  FAIL dry-run exclusions"; }
+mk eb; python3 "$B/archive_create/archive_and_clean.py" eb --out "$W/custom.tgz" >/dev/null 2>&1
+ck "--out custom path" "$([ -f "$W/custom.tgz" ] && echo y)" "y"
+ck "--out archive is not deleted with the contents" "$(tar tzf "$W/custom.tgz" | grep -c a.txt)" "1"
+python3 "$B/archive_create/archive_and_clean.py" "$W/nope" >/dev/null 2>&1; ck "missing dir -> exit 1" "$?" "1"
+
+echo "########## compile_pyc.py"
+mkdir -p pyc/pkg && cd pyc || exit 1
+printf 'def f():\n    return 1\n' > m1.py; printf 'x = 2\n' > pkg/m2.py
+python3 "$B/pyc_compile_tools/compile_pyc.py" . --quiet >/dev/null 2>&1
+ck "default run byte-compiled both" "$(find . -name '*.pyc' | wc -l)" "2"
+find . -name __pycache__ -exec rm -rf {} + 2>/dev/null
+python3 "$B/pyc_compile_tools/compile_pyc.py" m1.py --legacy --quiet >/dev/null 2>&1
+ck "--legacy writes the .pyc beside the source" "$([ -f m1.pyc ] && echo y)" "y"
+rm -f m1.pyc; find . -name __pycache__ -exec rm -rf {} + 2>/dev/null
+python3 "$B/pyc_compile_tools/compile_pyc.py" pkg --optimize 2 --quiet >/dev/null 2>&1
+ck "--optimize 2 produced an opt-2 pyc" "$(find . -name '*opt-2.pyc' | wc -l)" "1"
+find . -name __pycache__ -exec rm -rf {} + 2>/dev/null
+printf 'this is not python(((\n' > bad.py
+python3 "$B/pyc_compile_tools/compile_pyc.py" bad.py --quiet >/dev/null 2>&1; ck "broken file -> exit 1" "$?" "1"
+rm -f bad.py
+printf 'y=3\n' > gone.py; python3 "$B/pyc_compile_tools/compile_pyc.py" gone.py --remove-source --quiet >/dev/null 2>&1
+ck "--remove-source deleted the .py" "$([ -f gone.py ] && echo y || echo n)" "n"
+python3 "$B/pyc_compile_tools/compile_pyc.py" . --report-size --quiet 2>&1 | grep -q Traceback \
+  && { fail=$((fail+1)); echo "  FAIL --report-size crashed without dh"; } \
+  || { pass=$((pass+1)); echo "  PASS --report-size degrades gracefully without dh"; }
+python3 "$B/pyc_compile_tools/compile_pyc.py" --help >/dev/null 2>&1; ck "--help works" "$?" "0"
+cd "$W" || exit 1
+
+echo "########## pickle_convert.py"
+mkdir -p pk && cd pk || exit 1
+python3 -c "
+import pickle, pathlib
+pathlib.Path('d.pkl').write_bytes(pickle.dumps({'a':1,'b':[1,2,{'c'}]}))
+pathlib.Path('raw.pkl').write_bytes(pickle.dumps(b'\x00\x01raw bytes'))
+pathlib.Path('odd.pkl').write_bytes(pickle.dumps(object()))
+pathlib.Path('u.pkl').write_bytes(pickle.dumps({'سیب':'apple'}))
+pathlib.Path('m1.pkl').write_bytes(pickle.dumps({'one':1}))
+pathlib.Path('m2.pkl').write_bytes(pickle.dumps({'two':2}))
+pathlib.Path('notpickle.txt').write_bytes(pickle.dumps({'x':1}))
+"
+python3 "$B/pickle_convert/pickle_convert.py" d.pkl --quiet >/dev/null 2>&1
+ck "json written" "$([ -f d.json ] && echo y)" "y"
+ck "nested set -> list, rest intact" "$(python3 -c "import json;print(json.load(open('d.json'))['b'])")" "[1, 2, ['c']]"
+python3 "$B/pickle_convert/pickle_convert.py" u.pkl --quiet >/dev/null 2>&1
+ck "utf-8 kept by default" "$(grep -c 'سیب' u.json)" "1"
+python3 "$B/pickle_convert/pickle_convert.py" u.pkl --quiet --ensure-ascii --out u2.json >/dev/null 2>&1
+ck "--ensure-ascii escapes non-ASCII" "$(grep -c 'سیب' u2.json)" "0"
