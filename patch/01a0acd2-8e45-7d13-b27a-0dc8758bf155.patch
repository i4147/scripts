@@ -0,0 +1,146 @@
+#!/data/data/com.termux/files/home/.local/bin/python
+"""Scrape links out of a Telegram channel's messages.
+
+Merges the two scripts that lived in this folder:
+
+  t.me1.py        Clash-of-Clans invite pattern, last 100 messages, print only,
+                  credentials as constants in the file
+  telextractor.py generic URL pattern, server-side search, credentials from ~/.env
+                  via python-dotenv, sign in with a phone number, append to links.txt
+
+Every difference is a flag, so both workflows stay reachable:
+
+Usage: telegram_link_scraper.py [CHANNEL] [options]
+
+  CHANNEL                @username, https://t.me/... link or numeric id
+                         (default: https://t.me/pycode_hubb)
+  -p, --pattern          coc | url | REGEX   (default: url)
+  -s, --search QUERY     ask Telegram to filter messages by text first
+  -l, --limit N          stop after N messages, 0 = no limit (default: 0)
+  -o, --out FILE         append every match to FILE (t.me1.py only printed)
+      --message-id       prefix each hit with its message id
+      --phone NUMBER     sign in with this phone number (implies --start)
+      --start            authorize interactively if the session is not logged in
+      --session NAME     Telethon session file (default: session_name)
+      --api-id ID        Telegram API id    (else $API_ID, else the .env file)
+      --api-hash HASH    Telegram API hash  (else $API_HASH, else the .env file)
+      --env PATH         .env file to load (default: ~/.env)
+      --no-env           do not load a .env file at all
+
+Links are printed as they are found and appended to --out immediately, so a long
+crawl keeps the results it already has.
+"""
+from __future__ import annotations
+
+import argparse
+import asyncio
+import os
+import re
+import sys
+from pathlib import Path
+
+from telethon import TelegramClient
+
+DEFAULT_CHANNEL = "https://t.me/pycode_hubb"
+DEFAULT_SESSION = "session_name"
+
+PATTERNS = {
+    # t.me1.py: Clash of Clans invite links
+    "coc": r"https://link\.clashofclans\.com/[a-zA-Z0-9\?\=\&_]+",
+    # telextractor.py: any http(s) URL
+    "url": r"http[s]?://(?:[a-zA-Z]|[0-9]|[$-_@.&+]|[!*\\(\\),]|(?:%[0-9a-fA-F][0-9a-fA-F]))+",
+}
+
+
+def build_parser() -> argparse.ArgumentParser:
+    ap = argparse.ArgumentParser(
+        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
+    )
+    ap.add_argument("channel", nargs="?", default=DEFAULT_CHANNEL)
+    ap.add_argument("-p", "--pattern", default="url")
+    ap.add_argument("-s", "--search", default=None)
+    ap.add_argument("-l", "--limit", type=int, default=0)
+    ap.add_argument("-o", "--out", default=None)
+    ap.add_argument("--message-id", action="store_true")
+    ap.add_argument("--phone", default=None)
+    ap.add_argument("--start", action="store_true")
+    ap.add_argument("--session", default=DEFAULT_SESSION)
+    ap.add_argument("--api-id", default=None)
+    ap.add_argument("--api-hash", default=None)
+    ap.add_argument("--env", default=str(Path.home() / ".env"))
+    ap.add_argument("--no-env", action="store_true")
+    return ap
+
+
+def resolve_pattern(value: str) -> str:
+    if value in PATTERNS:
+        return PATTERNS[value]
+    return value  # a hand-written regex
+
+
+def load_credentials(args) -> tuple[str, str]:
+    """--api-id/--api-hash win, then the environment, then the .env file."""
+    api_id, api_hash = args.api_id, args.api_hash
+    if not (api_id and api_hash) and not args.no_env and args.env:
+        try:
+            from dotenv import load_dotenv
+
+            load_dotenv(Path(args.env))
+        except ImportError:
+            print("⚠️  python-dotenv is not installed; using the environment only")
+        except Exception as e:
+            print(f"⚠️  could not load {args.env}: {e}")
+    api_id = api_id or os.environ.get("API_ID")
+    api_hash = api_hash or os.environ.get("API_HASH")
+    if not api_id or not api_hash:
+        print(
+            "✗ missing credentials: pass --api-id/--api-hash, export API_ID/API_HASH, "
+            f"or put them in {args.env}"
+        )
+        raise SystemExit(2)
+    return api_id, api_hash
+
+
+async def crawl(args) -> int:
+    pattern = re.compile(resolve_pattern(args.pattern))
+    api_id, api_hash = load_credentials(args)
+    out_fh = open(args.out, "a", encoding="utf-8") if args.out else None
+    found = 0
+    try:
+        async with TelegramClient(args.session, api_id, api_hash) as client:
+            if args.phone:
+                await client.start(phone=args.phone)
+            elif args.start:
+                await client.start()
+            entity = await client.get_entity(args.channel)
+            title = getattr(entity, "title", args.channel)
+            print(f"Searching for links in {title}...")
+            if args.search:
+                print(f"  server-side search: '{args.search}'")
+            kwargs = {"search": args.search} if args.search else {}
+            if args.limit > 0:
+                kwargs["limit"] = args.limit
+            async for message in client.iter_messages(entity, **kwargs):
+                if not message.text:
+                    continue
+                for link in pattern.findall(message.text):
+                    found += 1
+                    prefix = f"message {message.id}: " if args.message_id else ""
+                    print(f"Found link: {prefix}{link}")
+                    if out_fh:
+                        out_fh.write(link + "\n")
+                        out_fh.flush()
+    finally:
+        if out_fh:
+            out_fh.close()
+    print(f"\n✅ {found} link(s) found" + (f" -> {args.out}" if args.out else ""))
+    return 0 if found else 1
+
+
+def main() -> int:
+    args = build_parser().parse_args()
+    return asyncio.run(crawl(args))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
