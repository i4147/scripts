@@ -0,0 +1,207 @@
+#!/data/data/com.termux/files/home/.local/bin/python
+"""Combine the CSS files of a project into one stylesheet.
+
+Merges the two scripts that lived in this folder:
+
+  joincss.py   pure Python: drop @import rules that pull Google Fonts, rewrite remote
+               font url()s to a local font directory, hoist a single @charset rule to
+               the top and banner-comment every source file
+  mergecss.py  shell out to `cleancss -O2 removeDuplicateRules:on *.css -o merged.css`
+
+joincss.py called an `atomic_write()` helper it never imported and iterated the string
+"." instead of a path list; both are fixed here.
+
+Usage: merge_css.py [PATH...] [-o merged.css] [--engine join|cleancss] [options]
+
+  PATH                     .css files and/or directories to search (default: cwd)
+  -o, --output FILE        where to write (default: merged.css)
+  --engine join|cleancss   join = pure Python (default), cleancss = external CLI
+  --keep-imports           keep @import url(...fonts.googleapis...) rules
+  --no-localize-fonts      leave remote font url()s untouched
+  --font-dir DIR           local font directory (default: /sdcard/_static/fonts)
+  --no-banner              no /* ===== name ===== */ separator between sources
+  --no-charset             drop @charset rules instead of hoisting the first one
+  --no-recursive           only the given directories' top level
+  --exclude NAME           skip a file name (repeatable; the output is always skipped)
+"""
+from __future__ import annotations
+
+import argparse
+import os
+import re
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+DEFAULT_OUTPUT = "merged.css"
+DEFAULT_FONT_DIR = Path("/sdcard/_static/fonts")
+FONTEXTS = {".woff", ".woff2", ".ttf", ".otf", ".eot"}
+IMGEXTS = {".png", ".jpg", ".jpeg", ".gif", ".svg", ".webp"}
+IMPORT_RE = re.compile(r"@import\s+url\([^)]+fonts\.googleapis[^)]+\);?", re.IGNORECASE)
+URL_RE = re.compile(
+    r"url\(([\"']?)(https?://[^)]+?\.(?:woff2?|ttf|otf|eot))\1\)", re.IGNORECASE
+)
+FAMILY_RULES = {
+    "roboto": "roboto",
+    "lato": "lato",
+    "opensans": "opensans",
+    "open-sans": "opensans",
+    "fontawesome": "fa",
+    "fa-": "fa",
+}
+
+
+def build_parser() -> argparse.ArgumentParser:
+    ap = argparse.ArgumentParser(
+        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
+    )
+    ap.add_argument("paths", nargs="*", default=["."])
+    ap.add_argument("-o", "--output", default=DEFAULT_OUTPUT)
+    ap.add_argument("--engine", choices=("join", "cleancss"), default="join")
+    ap.add_argument("--keep-imports", action="store_true")
+    ap.add_argument("--no-localize-fonts", action="store_true")
+    ap.add_argument("--font-dir", type=Path, default=DEFAULT_FONT_DIR)
+    ap.add_argument("--no-banner", action="store_true")
+    ap.add_argument("--no-charset", action="store_true")
+    ap.add_argument("--no-recursive", action="store_true")
+    ap.add_argument("--exclude", action="append", default=[])
+    return ap
+
+
+def find_css(paths, recursive: bool, exclude: set[str], output: Path) -> list[Path]:
+    """Collect .css files from explicit files and directories, de-duplicated."""
+    seen: set[Path] = set()
+    result: list[Path] = []
+    out_resolved = output.resolve()
+
+    def add(p: Path) -> None:
+        rp = p.resolve()
+        if rp in seen or rp == out_resolved or p.name in exclude:
+            return
+        seen.add(rp)
+        result.append(rp)
+
+    for raw in paths:
+        p = Path(raw)
+        if p.is_file():
+            if p.suffix.lower() == ".css":
+                add(p)
+            else:
+                print(f"Skipping non-CSS file: {p}", file=sys.stderr)
+        elif p.is_dir():
+            pattern = "**/*.css" if recursive else "*.css"
+            for f in sorted(p.glob(pattern)):
+                if f.is_file():
+                    add(f)
+        else:
+            print(f"Skipping invalid path: {p}", file=sys.stderr)
+    return result
+
+
+def atomic_write(output: str | Path, text: str) -> None:
+    """Write via a temp file in the same directory, then rename over the target."""
+    output = Path(output)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    fd, tmp_name = tempfile.mkstemp(
+        prefix=f".{output.name}.", suffix=".tmp", dir=str(output.parent)
+    )
+    tmp = Path(tmp_name)
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as fh:
+            fh.write(text)
+        tmp.replace(output)
+    except Exception:
+        if tmp.exists():
+            tmp.unlink()
+        raise
+
+
+def read_css(files, args):
+    """-> (charset line or None, [(path, cleaned text), ...])"""
+    charset_line = None
+    chunks = []
+
+    def localize_font_url(match) -> str:
+        url = match.group(2)
+        filename = url.split("/")[-1]
+        return f'url("{args.font_dir}/{filename}")'
+
+    for file in files:
+        text = file.read_text(errors="ignore")
+        if not args.keep_imports:
+            text = IMPORT_RE.sub("", text)
+        if not args.no_localize_fonts:
+            text = URL_RE.sub(localize_font_url, text)
+        cleaned = []
+        for line in text.splitlines():
+            stripped = line.strip().lower()
+            if stripped.startswith("@charset"):
+                if charset_line is None and not args.no_charset:
+                    charset_line = line.strip()
+                continue
+            cleaned.append(line)
+        chunks.append((file, "\n".join(cleaned).strip()))
+    return charset_line, chunks
+
+
+def join_css(files, args) -> int:
+    charset, chunks = read_css(files, args)
+    parts = []
+    if charset:
+        parts.append(charset + "\n")
+    for file, content in chunks:
+        if args.no_banner:
+            parts.append(f"\n{content}\n")
+        else:
+            parts.append(f"\n/* ===== {file.name} ===== */\n{content}\n")
+    final_css = "\n".join(parts).strip() + "\n"
+    atomic_write(args.output, final_css)
+    print(f"Joined {len(files)} files -> {args.output}")
+    return 0
+
+
+def cleancss(files, args) -> int:
+    """mergecss.py's behaviour: let the clean-css CLI do the merging."""
+    cmd = [
+        "cleancss",
+        "-O2",
+        "removeDuplicateRules:on",
+        *[str(f) for f in files],
+        "-o",
+        str(args.output),
+    ]
+    print("Running:", " ".join(cmd))
+    try:
+        res = subprocess.run(cmd, capture_output=True, text=True)
+    except FileNotFoundError:
+        print(f"✗ the clean-css CLI is not installed (tried to run '{cmd[0]}')", file=sys.stderr)
+        print("  install it with: npm install -g clean-css-cli", file=sys.stderr)
+        print("  or use the built-in engine: --engine join", file=sys.stderr)
+        return 127
+    except Exception as e:
+        print(f"✗ could not run {cmd[0]}: {e}", file=sys.stderr)
+        return 1
+    if res.stdout.strip():
+        print(res.stdout.strip())
+    if res.returncode != 0:
+        print(f"✗ cleancss failed: {res.stderr.strip()}", file=sys.stderr)
+        return res.returncode or 1
+    print(f"Merged {len(files)} files -> {args.output}")
+    return 0
+
+
+def main() -> int:
+    args = build_parser().parse_args()
+    exclude = set(args.exclude)
+    files = find_css(args.paths, not args.no_recursive, exclude, Path(args.output))
+    if not files:
+        print("No CSS files found.", file=sys.stderr)
+        return 1
+    if args.engine == "cleancss":
+        return cleancss(files, args)
+    return join_css(files, args)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
