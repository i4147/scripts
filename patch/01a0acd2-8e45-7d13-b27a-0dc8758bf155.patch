+#!/data/data/com.termux/files/home/.local/bin/python
+"""Byte-compile Python files to .pyc, in parallel.
+
+Merges the two scripts that lived in this folder:
+
+  mkpic.py   -o/--optimize 0|1|2, -l/--legacy (.pyc beside the source), a
+             REMOVE_ORIG constant that could only be changed by editing the file,
+             PYTHONPYCACHEPREFIX set to __pycache__, dh.mpf_async workers
+  mkpyc.py   a spawn Pool of 8 with a bounded window of 4 pending results, and a
+             before/after size report
+
+Everything either one could do is a flag now.
+
+Usage: compile_pyc.py [PATH...] [options]
+
+  PATH                    .py files and/or directories (default: current directory,
+                          searched recursively)
+  -o, --optimize LEVEL    0, 1 or 2 (default: 0)
+  -l, --legacy            write the .pyc next to the source instead of __pycache__
+      --remove-source     delete each .py after it compiled (mkpic's REMOVE_ORIG)
+  -w, --workers N         parallel workers (default: 8)
+      --max-queue N       keep at most N results pending, 0 = unbounded (default: 4)
+      --context spawn|fork|forkserver
+                          multiprocessing start method (default: spawn, as mkpyc)
+      --report-size       print how much space the run added or freed
+      --pycache-prefix DIR
+                          set PYTHONPYCACHEPREFIX (mkpic.py used __pycache__)
+      --quiet             only report failures
+"""
+from __future__ import annotations
+
+import argparse
+import compileall
+import os
+import sys
+from collections import deque
+from multiprocessing import get_context
+from pathlib import Path
+
+SKIP_DIRS = {".git", ".venv", "node_modules"}
+
+
+def build_parser() -> argparse.ArgumentParser:
+    ap = argparse.ArgumentParser(
+        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
+    )
+    ap.add_argument("paths", nargs="*", default=["."])
+    ap.add_argument("-o", "--optimize", type=int, default=0, choices=(0, 1, 2))
+    ap.add_argument("-l", "--legacy", action="store_true")
+    ap.add_argument("--remove-source", action="store_true")
+    ap.add_argument("-w", "--workers", type=int, default=8)
+    ap.add_argument("--max-queue", type=int, default=4)
+    ap.add_argument(
+        "--context",
+        default="spawn",
+        choices=("spawn", "fork", "forkserver"),
+    )
+    ap.add_argument("--report-size", action="store_true")
+    ap.add_argument("--pycache-prefix", default=None)
+    ap.add_argument("--quiet", action="store_true")
+    return ap
+
+
+def collect(paths) -> list[Path]:
+    found: list[Path] = []
+    seen: set[Path] = set()
+    for raw in paths:
+        p = Path(raw)
+        if p.is_file() and p.suffix == ".py":
+            rp = p.resolve()
+            if rp not in seen:
+                seen.add(rp)
+                found.append(p)
+        elif p.is_dir():
+            for f in sorted(p.rglob("*.py")):
+                if not f.is_file() or any(part in SKIP_DIRS for part in f.parts):
+                    continue
+                rp = f.resolve()
+                if rp not in seen:
+                    seen.add(rp)
+                    found.append(f)
+        else:
+            print(f"Skipping: {p}", file=sys.stderr)
+    return found
+
+
+def process_file(path, legacy: bool, optimize: int, remove_source: bool):
+    """-> (path, ok, message)"""
+    path = Path(path)
+    try:
+        if not path.exists() or path.is_symlink():
+            return (str(path), False, "missing or symlink")
+        if any(part in SKIP_DIRS for part in path.parts):
+            return (str(path), False, "skipped directory")
+        if legacy:
+            pyc_file = path.with_suffix(".pyc")
+            if pyc_file.exists():
+                pyc_file.unlink()
+        ok = compileall.compile_file(
+            str(path), optimize=optimize, legacy=legacy, quiet=1
+        )
+        if not ok:
+            return (str(path), False, "compile failed")
+        if remove_source:
+            path.unlink()
+        return (str(path), True, "")
+    except Exception as e:
+        return (str(path), False, str(e))
+
+
+def run_pool(files, args) -> list:
+    worker_args = (args.legacy, args.optimize, args.remove_source)
+    results = []
+    with get_context(args.context).Pool(args.workers) as pool:
+        if args.max_queue <= 0:
+            return pool.starmap(process_file, [(f, *worker_args) for f in files])
+        pending = deque()
+        for f in files:
+            pending.append(pool.apply_async(process_file, (f, *worker_args)))
+            if len(pending) > args.max_queue:
+                results.append(pending.popleft().get())
+        while pending:
+            results.append(pending.popleft().get())
+    return results
+
+
+def main() -> int:
+    args = build_parser().parse_args()
+    if args.pycache_prefix:
+        os.environ["PYTHONPYCACHEPREFIX"] = args.pycache_prefix
+
+    files = collect(args.paths)
+    if not files:
+        print("No Python files found to process")
+        return 0
+
+    size_before = 0
+    if args.report_size:
+        try:
+            from dh import gsz
+
+            size_before = gsz(Path.cwd())
+        except Exception:
+            args.report_size = False
+
+    if not args.quiet:
+        mode = "legacy .pyc" if args.legacy else "__pycache__"
+        print(f"Compiling {len(files)} file(s) -> {mode}, optimize={args.optimize}")
+
+    if len(files) == 1:
+        results = [process_file(files[0], args.legacy, args.optimize, args.remove_source)]
+    else:
+        results = run_pool(files, args)
+
+    failed = [(p, msg) for p, ok, msg in results if not ok]
+    compiled = sum(1 for _, ok, _ in results if ok)
+    if failed:
+        print(f"\nFailed ({len(failed)}):")
+        for p, msg in failed:
+            print(f"  - {p}: {msg}")
+    if not args.quiet:
+        suffix = " (sources removed)" if args.remove_source else ""
+        print(f"\nCompiled {compiled}/{len(results)} file(s){suffix}")
+
+    if args.report_size:
+        from dh import fsz, gsz
+
+        after = gsz(Path.cwd())
+        diff = after - size_before
+        sign = "+" if diff > 0 else "-" if diff < 0 else ""
+        print(f"space changed : {sign} {fsz(abs(diff))}")
+    return 0 if not failed else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
