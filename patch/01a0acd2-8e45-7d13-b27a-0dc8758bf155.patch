+#!/data/data/com.termux/files/home/.local/bin/python
+"""Recompress .gz archives as .xz and .xz archives as .gz, in place.
+
+Replaces gz2xz.py and xz2gz.py, which were 93% identical and both reported a 0-byte
+original size (they stat()ed the source *after* unlinking it, so the ratio and the
+"total space saved" summary were always empty).  gz2xz.py also called get_files()
+without importing it.
+
+Direction is decided per file from its extension, so a directory holding both kinds is
+converted in one pass:
+
+  .gz -> gzip-decompress -> xz-compress   (preset 9, 4 threads, via lzma_mt)
+  .xz -> xz-decompress   -> gzip-compress (level 9, via lzma_mt)
+
+The source archive is removed only after the new archive exists and is non-empty; on
+any error the partial output is removed and the source is kept.
+
+Usage: convert_gz_xz.py [DIRECTORY] [--to auto|xz|gz] [--dry-run]
+"""
+from __future__ import annotations
+
+import gzip
+import sys
+from functools import partial
+from pathlib import Path
+
+from dh import fsz, get_files, mpf3
+from lzma_mt import compress as xz_compress
+from lzma_mt import decompress as xz_decompress
+
+PRESET = 9
+THREADS = 4
+
+
+def target_for(path: Path, to: str) -> tuple[str, Path] | None:
+    """Return (source suffix, destination path) for one file, or None to skip it."""
+    if path.suffix == ".gz" and to in ("auto", "xz"):
+        return ".gz", path.with_suffix(".xz")
+    if path.suffix == ".xz" and to in ("auto", "gz"):
+        return ".xz", path.with_suffix(".gz")
+    return None
+
+
+def recompress(data: bytes, src_suffix: str) -> bytes:
+    if src_suffix == ".gz":
+        return xz_compress(data, preset=PRESET, threads=THREADS)
+    return gzip.compress(data, compresslevel=PRESET)
+
+
+def read_archive(path: Path, src_suffix: str) -> bytes:
+    if src_suffix == ".gz":
+        with gzip.open(path, "rb") as fh:
+            return fh.read()
+    return xz_decompress(path.read_bytes(), threads=THREADS)
+
+
+def process_file(path, to="auto", dry_run=False):
+    """-> (path, ok, message, original_size, new_size)"""
+    path = Path(path)
+    plan = target_for(path, to)
+    if plan is None:
+        return (str(path), False, "skipped: not a convertible archive", 0, 0)
+    src_suffix, dest = plan
+    if path.is_symlink():
+        return (str(path), False, "skipped: symlink", 0, 0)
+    original_size = path.stat().st_size
+    if dry_run:
+        return (
+            str(path),
+            True,
+            f"[dry-run] {path.name} -> {dest.name} ({fsz(original_size)})",
+            original_size,
+            0,
+        )
+    try:
+        payload = recompress(read_archive(path, src_suffix), src_suffix)
+        dest.write_bytes(payload)
+        if not (dest.exists() and dest.stat().st_size > 0):
+            raise RuntimeError("output file is empty or missing")
+        new_size = dest.stat().st_size
+        path.unlink()
+        return (str(path), True, f"{path.name} -> {dest.name}", original_size, new_size)
+    except Exception as e:
+        if dest.exists():
+            dest.unlink()
+        return (str(path), False, f"error: {e!s}", original_size, 0)
+
+
+def parse_args(argv: list[str]) -> tuple[Path, str, bool]:
+    directory = Path.cwd()
+    to = "auto"
+    dry_run = False
+    i = 0
+    while i < len(argv):
+        arg = argv[i]
+        if arg == "--to":
+            i += 1
+            to = argv[i]
+        elif arg.startswith("--to="):
+            to = arg.split("=", 1)[1]
+        elif arg in ("-n", "--dry-run"):
+            dry_run = True
+        elif arg in ("-h", "--help"):
+            print(__doc__)
+            raise SystemExit(0)
+        else:
+            directory = Path(arg)
+        i += 1
+    if to not in ("auto", "xz", "gz"):
+        print("✗ --to must be auto, xz or gz")
+        raise SystemExit(2)
+    return directory, to, dry_run
+
+
+def main() -> None:
+    directory, to, dry_run = parse_args(sys.argv[1:])
+    wanted = [".gz", ".xz"] if to == "auto" else [".gz" if to == "xz" else ".xz"]
+    files = get_files(directory, ext=wanted)
+    files = [p for p in files if target_for(Path(p), to) and not Path(p).is_symlink()]
+    if not files:
+        print(f"No {'/'.join(wanted)} files found to convert in {directory}.")
+        return
+
+    print("=" * 46)
+    print("CONVERSION RESULTS" + ("  [dry run]" if dry_run else ""))
+    print("-" * 46)
+    results = mpf3(partial(process_file, to=to, dry_run=dry_run), files)
+
+    ok = failed = 0
+    total_before = total_after = 0
+    for path, success, message, before, after in results:
+        if success:
+            ok += 1
+            total_before += before
+            total_after += after
+            if dry_run or not before:
+                print(f"✓ {message}")
+            else:
+                saved = before - after
+                pct = saved / before * 100 if before else 0.0
+                print(f"✓ {message}  ({fsz(before)} -> {fsz(after)}, saved {pct:.1f}%)")
+        else:
+            failed += 1
+            print(f"✗ {path}: {message}", file=sys.stderr)
+
+    print("-" * 46)
+    print(f"Summary: {ok} successful, {failed} failed, {len(results)} processed")
+    if ok and not dry_run and total_before:
+        saved = total_before - total_after
+        print(f"Total: {fsz(total_before)} -> {fsz(total_after)}")
+        print(f"Space saved: {fsz(saved)} ({saved / total_before * 100:.1f}%)")
+        print("\nNote: the original archives have been removed.")
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
