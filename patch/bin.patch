+""" stripsofiles """
 from __future__ import annotations
+import ctypes
+import subprocess
 import time
 from pathlib import Path
 
 
+class SoFileStripper:
+    """Strip a shared object while preserving a per-run success/failure summary."""
+
+    def __init__(self, verbose: bool = False, verify_ctypes: bool = True) -> None:
+        self.verbose = verbose
+        self.verify_ctypes = verify_ctypes
+        self.stats = {"processed": 0, "success": 0, "failed": 0, "saved_bytes": 0}
+
+    def process_file(self, path: Path) -> dict[str, object]:
+        path = Path(path)
+        before_size = path.stat().st_size
+        try:
+            completed = subprocess.run(
+                ["strip", "--strip-unneeded", str(path)], capture_output=True, text=True, check=False
+            )
+            if completed.returncode != 0:
+                raise RuntimeError(completed.stderr.strip() or "strip failed")
+            if self.verify_ctypes:
+                ctypes.CDLL(str(path))
+            after_size = path.stat().st_size
+            self.stats["processed"] += 1
+            self.stats["success"] += 1
+            self.stats["saved_bytes"] += max(0, before_size - after_size)
+            if self.verbose:
+                print(f"Stripped {path}: {before_size} -> {after_size} bytes")
+            return {"success": True, "path": path, "saved_bytes": max(0, before_size - after_size)}
+        except (OSError, RuntimeError) as exc:
+            self.stats["processed"] += 1
+            self.stats["failed"] += 1
+            print(f"Could not strip {path}: {exc}")
+            return {"success": False, "path": path, "error": str(exc)}
+
